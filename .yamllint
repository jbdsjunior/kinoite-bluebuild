---
# yamllint configuration for the kinoite-bluebuild repository.
# Run with: yamllint --strict -f github .
extends: default

rules:
  # GitHub Actions/BlueBuild files deliberately omit the leading "---".
  document-start: disable

  # `on:` is a valid workflow key but YAML 1.1 parses it as a boolean.
  truthy:
    check-keys: false
    allowed-values:
      - "true"
      - "false"
      - "on"
      - "off"

  # Long pinned-SHA references and single-line shell commands exceed 80 columns.
  line-length:
    max: 180

  # Existing style uses a single space before trailing comments.
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable

  # Shell heredocs inside `run:` blocks are not indented as YAML lists.
  indentation:
    spaces: 2
    indent-sequences: whatever
    check-multi-line-strings: false

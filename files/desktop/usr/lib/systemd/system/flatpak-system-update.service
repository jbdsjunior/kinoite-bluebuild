[Unit]
Description=Apply Flatpak system updates
Documentation=man:flatpak(1) man:flatpak-update(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

Environment=XDG_CACHE_HOME=/tmp
ExecCondition=/usr/bin/nm-online -q -t 15
ExecStart=/usr/bin/flatpak --system update -y --noninteractive
ExecStart=/usr/bin/flatpak --system uninstall --unused -y --noninteractive

ProtectSystem=full
ReadWritePaths=/var/lib/flatpak /var/tmp -/run/flatpak
ProtectHome=true
PrivateTmp=true

Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle

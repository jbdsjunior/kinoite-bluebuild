# Microsoft OneDrive Environment Configuration for rclone@OneDrive.service
# System reference: /usr/share/rclone/env/OneDrive.env
# User override: ~/.config/rclone/env/OneDrive.env

RCLONE_TPSLIMIT=5
RCLONE_TPSLIMIT_BURST=6
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=4
RCLONE_BUFFER_SIZE=16M
RCLONE_VFS_READ_AHEAD=32M
RCLONE_ONEDRIVE_CHUNK_SIZE=50M
RCLONE_ONEDRIVE_DELTA=true

# Optional overrides:
# RCLONE_REMOTE=OneDrive:
# RCLONE_FLAGS=

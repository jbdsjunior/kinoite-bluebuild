# Microsoft OneDrive Environment Configuration for rclone@OneDrive.service
# System reference: /usr/share/rclone/env/OneDrive.env
# System template (authoritatively refreshed at boot): ~/.config/rclone/env/OneDrive.env
# User persistent override: ~/.config/rclone/env/OneDrive.local.env

# Rate limits conservadores para evitar o HTTP 429 da API Graph (burst calibrado para 10)
RCLONE_TPSLIMIT=5
RCLONE_TPSLIMIT_BURST=10
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=4

# Buffer em RAM, leitura antecipada e streams paralelos de chunks
RCLONE_BUFFER_SIZE=32M
RCLONE_VFS_READ_AHEAD=64M
RCLONE_VFS_READ_CHUNK_STREAMS=4

# Politica de cache VFS e retencao local (mantem SSD limpo e dados na nuvem)
RCLONE_VFS_CACHE_MAX_SIZE=15G
RCLONE_VFS_CACHE_MAX_AGE=24h
RCLONE_VFS_CACHE_MIN_FREE_SPACE=15G
RCLONE_VFS_CACHE_POLL_INTERVAL=1m
RCLONE_VFS_WRITE_BACK=10s

# Retencao de atributos no kernel FUSE e deteccao de alteracoes remotas via Microsoft Graph Delta API
RCLONE_DIR_CACHE_TIME=24h
RCLONE_ATTR_TIMEOUT=1h
RCLONE_POLL_INTERVAL=1m

# Backend Microsoft OneDrive:
# chunk_size DEVE ser multiplo exato de 320 KiB (327.680 bytes).
# 50M = 52.428.800 bytes = 160 * 320 KiB (valido). Valores como 64M/32M nao sao multiplos de 5 e falham.
RCLONE_ONEDRIVE_CHUNK_SIZE=50M
RCLONE_ONEDRIVE_DELTA=true
RCLONE_ONEDRIVE_LIST_CHUNK=1000

# Optional overrides:
# RCLONE_REMOTE=OneDrive:
# RCLONE_FLAGS=

# Google Drive Environment Configuration for rclone@GoogleDrive.service
# System reference: /usr/share/rclone/env/GoogleDrive.env
# System template (authoritatively refreshed at boot): ~/.config/rclone/env/GoogleDrive.env
# User persistent override: ~/.config/rclone/env/GoogleDrive.local.env

# Rate limits recomendados para a API do Google Drive (10 req/s)
RCLONE_TPSLIMIT=10
RCLONE_TPSLIMIT_BURST=10
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8

# Buffer e leitura antecipada no cache VFS em disco
RCLONE_BUFFER_SIZE=16M
RCLONE_VFS_READ_AHEAD=32M

# Politica de cache VFS e retencao local (mantem SSD limpo e dados na nuvem)
RCLONE_VFS_CACHE_MAX_SIZE=15G
RCLONE_VFS_CACHE_MAX_AGE=24h
RCLONE_VFS_CACHE_MIN_FREE_SPACE=15G
RCLONE_VFS_CACHE_POLL_INTERVAL=1m
RCLONE_VFS_WRITE_BACK=5s

# Sincronizacao de alteracoes remotas quase em tempo real (Drive Changes API)
RCLONE_DIR_CACHE_TIME=24h
RCLONE_POLL_INTERVAL=15s

# Backend Google Drive:
# Oculta docs nativos para evitar erros de I/O de apps desktop.
# Para expor como atalhos web (.link.html), configure no seu GoogleDrive.local.env:
# RCLONE_DRIVE_SKIP_GDOCS=false
# RCLONE_FLAGS="--drive-export-formats link.html"
RCLONE_DRIVE_SKIP_GDOCS=true

# Envia arquivos excluidos para a lixeira na nuvem (retencao de 30 dias contra perda acidental)
RCLONE_DRIVE_USE_TRASH=true

# chunk_size DEVE ser potencia de 2 >= 256k (64M = 2^26 bytes, valido e performatico)
RCLONE_DRIVE_CHUNK_SIZE=64M

# Optional overrides:
# RCLONE_REMOTE=GoogleDrive:
# RCLONE_FLAGS=

// Polkit rule for libvirt management permissions.
// Least-privilege policy: wheel/libvirt users may manage libvirt without extra authentication.
// Active local sessions are granted read-only access for monitoring.

polkit.addRule(function(action, subject) {
    // Allow libvirt management for users in wheel or libvirt group
    if (action.id == "org.libvirt.unix.manage" && (subject.isInGroup("wheel") || subject.isInGroup("libvirt"))) {
        return polkit.Result.YES;
    }

    // Allow read-only access to libvirt for active local sessions or members of wheel/libvirt
    if (action.id == "org.libvirt.unix.read" && (subject.isInGroup("wheel") || subject.isInGroup("libvirt") || (subject.local && subject.active))) {
        return polkit.Result.YES;
    }
});

[Appearance]
ColorScheme=Kinoite
Font=JetBrainsMono Nerd Font,10.5,-1,5,50,0,0,0,0,0
LineSpacing=2
UseFontLineCharacters=true

[Cursor Options]
CursorShape=2
UseCustomCursorColor=false

[General]
Name=Kinoite
Parent=FALLBACK/
TerminalMargin=12
WordCharacters=:@-./_~?&=%+#

[Interaction]
UnderlineLinksEnabled=true
UnderlineFilesEnabled=true

[Keyboard]
KeyBindings=default

[Scrolling]
HistoryMode=1
HistorySize=10000
ScrollBarPosition=2

[Terminal Features]
BlinkingCursorEnabled=false
BlinkingTextEnabled=true
FlowControlEnabled=false

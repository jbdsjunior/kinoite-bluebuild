# Peripheral access: VXE Mouse / Compx receivers
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", MODE="0660", TAG+="uaccess"

# Peripheral access: MCHOSE X9 headset
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3837", MODE="0660", TAG+="uaccess"

# Peripheral access: BY Tech gaming keyboard
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", MODE="0660", TAG+="uaccess"

# Peripheral access: ITE RGB motherboard and LED controller
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", MODE="0660", TAG+="uaccess"

# NOTE: /dev/kfd, /dev/dri/renderD* and the NVMe I/O scheduler are already handled by
# upstream Fedora rules (50-udev-default.rules: kfd/renderD* 0666 group render;
# NVMe defaults to the "none" scheduler). Declaring them here would be redundant.

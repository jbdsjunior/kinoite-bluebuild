[Unit]
Description=Kinoite Native First-Boot Initialization (GRUB Auto-Hide)
Documentation=man:grub2-editenv(1)
After=local-fs.target
ConditionPathExists=!/var/lib/kinoite-boot-init-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/grub2-editenv - set menu_auto_hide=1
ExecStart=-/usr/bin/grub2-editenv - set boot_success=1
ExecStartPost=/usr/bin/touch /var/lib/kinoite-boot-init-done

[Install]
WantedBy=multi-user.target

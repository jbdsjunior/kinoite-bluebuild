[Unit]
Description=Apply Flatpak system updates
Documentation=man:flatpak-update(1)
After=network-online.target
Wants=network-online.target

ConditionACPower=true

[Service]
Type=oneshot
ExecCondition=/bin/bash -c '[[ "$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered | cut -c 3-)" == @(2|4) ]]'
ExecStart=/usr/bin/sh -c '/usr/bin/flatpak --system uninstall --unused -y --noninteractive ; /usr/bin/flatpak --system update -y --noninteractive'
RestartSec=1h
Restart=on-failure

CapabilityBoundingSet=
ProtectSystem=full

# --- Configurações de Ociosidade e Baixo Impacto ---
# Reduz a prioridade da CPU para o nível mais baixo possível
Nice=19
# Só usa o processador se não houver mais nada exigindo dele
CPUSchedulingPolicy=idle
# Só acessa o disco se nenhum outro programa estiver lendo/escrevendo
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target

[Unit]
Description=Flatpak System Updates Timer
Documentation=man:flatpak-update(1) man:systemd.timer(5)
# CORREÇÃO: ConditionACPower removido daqui para garantir que o timer inicie no boot.

[Timer]
Unit=flatpak-system-update.service
OnBootSec=15m
OnUnitActiveSec=1h
RandomizedDelaySec=15m
AccuracySec=5m
Persistent=true

[Install]
WantedBy=timers.target

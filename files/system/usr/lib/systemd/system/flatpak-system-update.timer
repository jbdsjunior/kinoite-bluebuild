[Unit]
Description=Flatpak System Updates Timer
Documentation=man:flatpak-update(1) man:systemd.timer(5)

[Timer]
# Reset base upstream timer triggers before declaring the project cadence,
# mirroring the bootc/podman overrides (prevents duplicated update runs).
OnBootSec=
OnUnitActiveSec=
OnUnitInactiveSec=
OnCalendar=
RandomizedDelaySec=0
Persistent=false
OnBootSec=5m
OnUnitActiveSec=45m
AccuracySec=5m

[Install]
WantedBy=timers.target

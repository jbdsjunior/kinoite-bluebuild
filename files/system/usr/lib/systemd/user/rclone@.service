# =============================================================================
# SYSTEMD HARDENING (Segurança) - CORRIGIDO PARA FUSE
# =============================================================================
# NOTA: FUSE (fusermount3) requer syscalls privilegiadas mesmo sendo SUID root.
# O SystemCallFilter deve permitir @mount, @chown, @setuid, @setgid.
# =============================================================================

# Restringe acesso ao filesystem (apenas diretórios necessários)
ProtectHome=tmpfs
BindPaths=%h/.config/rclone:%h/.config/rclone
BindPaths=%h/Cloud:%h/Cloud
BindPaths=%h/.cache/rclone:%h/.cache/rclone
BindPaths=/run/user/%U:/run/user/%U

# Previne que o serviço ganhe novos privilégios
NoNewPrivileges=no  # FUSE precisa de privilégios para mount
# Alternativa mais segura: usar NoNewPrivileges=yes mas remover ProtectHome

# Usa /tmp privado para o serviço
PrivateTmp=yes

# IMPORTANTE: FUSE precisa de CAP_SYS_ADMIN para mount
CapabilityBoundingSet=CAP_FOWNER CAP_DAC_OVERRIDE CAP_CHOWN CAP_FSETID CAP_SETFCAP CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_FOWNER CAP_DAC_OVERRIDE CAP_CHOWN CAP_FSETID CAP_SETFCAP CAP_SYS_ADMIN CAP_SETUID CAP_SETGID

# Previne acesso a dispositivos de hardware sensíveis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

# Previne acesso a clocks do sistema
ProtectClock=yes

# Previne modificações no hostname
ProtectHostname=yes

# Previne acesso a personality do kernel
LockPersonality=yes

# =============================================================================
# SYSTEM CALL FILTER - CORRIGIDO PARA FUSE
# =============================================================================
# FUSE (fusermount3) precisa de syscalls de mount/unmount e setuid/setgid.
# Estas syscalls são bloqueadas por padrão em @system-service.
# =============================================================================

# Permite syscalls básicas de serviço
SystemCallFilter=@system-service

# IMPORTANTE: Permite syscalls de mount/unmount (necessário para FUSE)
SystemCallFilter=@mount

# Permite syscalls de mudança de UID/GID (necessário para fusermount3 SUID)
SystemCallFilter=@chown @setuid @setgid

# Permite syscalls de recursos (mmap, mprotect, etc)
SystemCallFilter=@resources

# Bloqueia syscalls perigosas (mantém segurança)
SystemCallFilter=~@clock           # Previne mudança de clock do sistema
SystemCallFilter=~@cpu-emulation   # Previne emulação de CPU (obsoleto)
SystemCallFilter=~@debug           # Previne debugging do kernel
SystemCallFilter=~@module          # Previne carregar módulos do kernel
SystemCallFilter=~@obsolete        # Previne syscalls obsoletas
SystemCallFilter=~@raw-io          # Previne I/O raw (ioperm, iopl)
SystemCallFilter=~@reboot          # Previne reboot do sistema
SystemCallFilter=~@swap            # Previne manipulação de swap
SystemCallFilter=~@privileged      # Previne syscalls privilegiadas desnecessárias
SystemCallFilter=~@pkey            # Previne manipulação de memory protection keys

# Arquiteturas permitidas (apenas nativa)
SystemCallArchitectures=native

# Previne criação de namespaces (não necessário para rclone)
RestrictNamespaces=yes

# Previne real-time scheduling
RestrictRealtime=yes

# Previne SUID/SGID (exceto para fusermount3 que já é SUID)
RestrictSUIDSGID=no  # Necessário para fusermount3

# Modo de proteção do sistema (apenas leitura, exceto BindPaths)
ProtectSystem=strict
ReadWritePaths=%h/.config/rclone %h/Cloud %h/.cache/rclone /run/user/%U

# Alternativa mais segura (mas pode quebrar alguns recursos):
# ProtectSystem=full
# ProtectHome=read-only
# BindReadOnlyPaths=%h/.config/rclone:%h/.config/rclone

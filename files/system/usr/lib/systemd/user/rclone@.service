[Unit]
Description=Rclone mount for KDE Plasma - %i
Documentation=https://rclone.org/commands/rclone_mount/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=20

[Service]
Type=notify
TimeoutStartSec=30
Environment=RCLONE_REMOTE=%i:
Environment=RCLONE_MOUNT=%h/Cloud/%i
Environment=RCLONE_CACHE=%h/.cache/rclone/%i
Environment=RCLONE_BWLIMIT=0
Environment=RCLONE_BUFFER_SIZE=16M
Environment=RCLONE_TRANSFERS=4
Environment=RCLONE_CHECKERS=8
Environment=RCLONE_TPSLIMIT=10
Environment=RCLONE_TPSLIMIT_BURST=10
Environment=RCLONE_VFS_READ_AHEAD=32M
Environment=RCLONE_VFS_READ_CHUNK_SIZE_LIMIT=512M
Environment=RCLONE_FLAGS=
EnvironmentFile=-%h/.config/rclone/env/%i.env

ExecStartPre=/usr/bin/mkdir -p ${RCLONE_MOUNT}
ExecStartPre=/usr/bin/mkdir -p ${RCLONE_CACHE}

ExecStart=/usr/bin/rclone mount ${RCLONE_REMOTE} ${RCLONE_MOUNT} \
  --config %h/.config/rclone/rclone.conf \
  --exclude /.Trash-1000/** \
  --exclude /.Trash/** \
  --exclude /.trashinfo/** \
  --cache-dir ${RCLONE_CACHE} \
  --vfs-cache-mode full \
  --vfs-cache-max-size 20G \
  --vfs-cache-max-age 72h \
  --vfs-fast-fingerprint \
  --vfs-read-chunk-size 8M \
  --vfs-read-chunk-size-limit ${RCLONE_VFS_READ_CHUNK_SIZE_LIMIT} \
  --vfs-read-ahead ${RCLONE_VFS_READ_AHEAD} \
  --vfs-write-back 5s \
  --dir-cache-time 72h \
  --poll-interval 1m \
  --buffer-size ${RCLONE_BUFFER_SIZE} \
  --transfers ${RCLONE_TRANSFERS} \
  --checkers ${RCLONE_CHECKERS} \
  --tpslimit ${RCLONE_TPSLIMIT} \
  --tpslimit-burst ${RCLONE_TPSLIMIT_BURST} \
  --bwlimit ${RCLONE_BWLIMIT} \
  --timeout 2m \
  --contimeout 20s \
  --low-level-retries 10 \
  --retries 10 \
  --attr-timeout 5s \
  --umask 0022 \
  --log-level NOTICE \
  --log-systemd \
  $RCLONE_FLAGS

ExecStop=-/usr/bin/fusermount3 -uz ${RCLONE_MOUNT}
ExecStopPost=-/usr/bin/rmdir --ignore-fail-on-non-empty ${RCLONE_MOUNT}
Restart=on-failure
RestartSec=30s
TimeoutStopSec=15s


LimitNOFILE=1048576
MemoryMax=4G
CPUQuota=200%
IOSchedulingClass=best-effort
IOSchedulingPriority=4

[Install]
WantedBy=default.target

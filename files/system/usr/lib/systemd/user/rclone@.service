[Unit]
Description=rclone FUSE mount for remote %i
Documentation=man:rclone(1)
Wants=network-online.target
After=network-online.target default.target

[Service]
Type=notify
EnvironmentFile=-%h/.config/rclone/env/%i.env
EnvironmentFile=-%h/.config/rclone/env/.env
Environment=RCLONE_REMOTE=%i:
ExecStart=/usr/bin/rclone mount ${RCLONE_REMOTE} %h/Cloud/%i \
  --config %h/.config/rclone/rclone.conf \
  --vfs-cache-mode full \
  --vfs-cache-max-age 72h \
  --vfs-cache-max-size 10G \
  --dir-cache-time 72h \
  --transfers 4 \
  --checkers 8 \
  --tpslimit 10 \
  --bwlimit ${RCLONE_BWLIMIT:-0} \
  --exclude "/.Trash-1000/**"
ExecStop=/bin/fusermount -u %h/Cloud/%i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

#!/usr/bin/env python3
"""
Kinoite Push Update Receiver (FCM-style)
Validates HMAC-SHA256 signed update triggers and starts bootc update service.
"""

import sys
import os
import time
import hmac
import hashlib
import subprocess
import syslog

SECRET_FILE = "/etc/kinoite-update.secret"
MAX_TIME_DIFF = 300  # 5 minutes maximum allowed clock drift / replay window

def log_info(msg):
    syslog.syslog(syslog.LOG_INFO, f"[kinoite-update-receiver] {msg}")

def log_warn(msg):
    syslog.syslog(syslog.LOG_WARNING, f"[kinoite-update-receiver] {msg}")

def log_err(msg):
    syslog.syslog(syslog.LOG_ERR, f"[kinoite-update-receiver] {msg}")

def send_response(status_code, status_text, body):
    payload = body.encode("utf-8")
    resp = (
        f"HTTP/1.1 {status_code} {status_text}\r\n"
        f"Content-Type: text/plain; charset=utf-8\r\n"
        f"Content-Length: {len(payload)}\r\n"
        f"Connection: close\r\n\r\n"
    ).encode("utf-8") + payload
    try:
        sys.stdout.buffer.write(resp)
        sys.stdout.buffer.flush()
    except Exception:
        pass

def notify_desktop(title, message):
    """Notify active graphical user sessions using notify-send via user dbus session."""
    try:
        res = subprocess.run(
            ["/usr/bin/loginctl", "list-sessions", "--no-legend"],
            capture_output=True, text=True, timeout=5
        )
        for line in res.stdout.strip().splitlines():
            parts = line.split()
            if not parts:
                continue
            session_id = parts[0]
            user_res = subprocess.run(
                ["/usr/bin/loginctl", "show-session", "-p", "User", "--value", session_id],
                capture_output=True, text=True, timeout=5
            )
            uid = user_res.stdout.strip()
            if uid and uid.isdigit():
                bus_addr = f"unix:path=/run/user/{uid}/bus"
                cmd = [
                    "/usr/bin/sudo", "-u", f"#{uid}",
                    "DBUS_SESSION_BUS_ADDRESS=" + bus_addr,
                    "/usr/bin/notify-send",
                    "-i", "system-software-update",
                    "-a", "Kinoite System Update",
                    title,
                    message
                ]
                subprocess.run(cmd, timeout=5, stderr=subprocess.DEVNULL)
    except Exception as e:
        log_warn(f"Failed to dispatch desktop notification: {e}")

def main():
    syslog.openlog("kinoite-update-receiver", syslog.LOG_PID, syslog.LOG_DAEMON)

    # 1. Verify that secret key exists and has restrictive permissions
    if not os.path.isfile(SECRET_FILE):
        log_err(f"Secret key file {SECRET_FILE} does not exist. Aborting.")
        send_response(500, "Internal Server Error", "Configuration error: secret key not configured\n")
        return

    try:
        stat_info = os.stat(SECRET_FILE)
        # Verify permissions: only root should read (mode 0400 or 0600)
        if stat_info.st_mode & 0o077:
            log_warn(f"Insecure permissions on {SECRET_FILE} ({oct(stat_info.st_mode)}). Expected 0400/0600.")
        with open(SECRET_FILE, "rb") as f:
            secret_key = f.read().strip()
    except Exception as e:
        log_err(f"Failed to read {SECRET_FILE}: {e}")
        send_response(500, "Internal Server Error", "Configuration read error\n")
        return

    if not secret_key:
        log_err(f"Secret key in {SECRET_FILE} is empty.")
        send_response(500, "Internal Server Error", "Secret key is empty\n")
        return

    # 2. Parse incoming HTTP request
    headers = {}
    try:
        req_line = sys.stdin.buffer.readline().decode("utf-8", errors="replace").strip()
        if not req_line:
            return
        parts = req_line.split()
        if len(parts) < 2 or parts[0].upper() != "POST":
            send_response(405, "Method Not Allowed", "Method Not Allowed: only POST supported\n")
            return

        while True:
            line = sys.stdin.buffer.readline().decode("utf-8", errors="replace")
            if not line or line in ("\r\n", "\n"):
                break
            if ":" in line:
                k, v = line.split(":", 1)
                headers[k.strip().lower()] = v.strip()

        content_length = int(headers.get("content-length", 0))
        if content_length > 65536:
            send_response(413, "Payload Too Large", "Payload too large\n")
            return

        body = sys.stdin.buffer.read(content_length)
    except Exception as e:
        log_err(f"Malformed HTTP request: {e}")
        send_response(400, "Bad Request", "Malformed HTTP request\n")
        return

    # 3. Validate Authentication Headers
    received_sig = headers.get("x-signature")
    received_timestamp = headers.get("x-timestamp")

    if not received_sig or not received_timestamp:
        log_warn("Rejected request missing X-Signature or X-Timestamp headers.")
        send_response(401, "Unauthorized", "Missing X-Signature or X-Timestamp\n")
        return

    try:
        timestamp = int(received_timestamp)
    except ValueError:
        log_warn("Rejected request with non-integer X-Timestamp.")
        send_response(400, "Bad Request", "Invalid X-Timestamp format\n")
        return

    # 4. Anti-replay verification
    now = int(time.time())
    if abs(now - timestamp) > MAX_TIME_DIFF:
        log_warn(f"Rejected request outside replay window (diff={abs(now - timestamp)}s > {MAX_TIME_DIFF}s).")
        send_response(403, "Forbidden", "Timestamp outside permitted window\n")
        return

    # 5. Cryptographic HMAC-SHA256 verification
    expected_sig = hmac.new(secret_key, body, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected_sig.lower(), received_sig.lower()):
        log_warn("HMAC signature verification failed. Possible forgery or mismatched secret.")
        send_response(403, "Forbidden", "Invalid HMAC signature\n")
        return

    # 6. Request is authentic and validated
    log_info("Authentic update trigger received from pipeline.")
    send_response(200, "OK", "Update triggered successfully\n")

    # 7. Notify active user sessions and start update service
    notify_desktop("Atualização Disponível (Push)", "Nova imagem do sistema detectada. Baixando atualização...")

    try:
        subprocess.run(
            ["/usr/bin/systemctl", "start", "--no-block", "bootc-fetch-apply-updates.service"],
            check=True
        )
        log_info("Triggered bootc-fetch-apply-updates.service successfully.")
    except Exception as e:
        log_err(f"Failed to start bootc update service: {e}")

if __name__ == "__main__":
    main()


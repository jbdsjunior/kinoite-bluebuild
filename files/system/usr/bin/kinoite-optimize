#!/usr/bin/env bash
set -euo pipefail

# Critical flow: detect privilege level and calling user environment
IS_ROOT=0
CAN_SUDO=0
SUDO_CMD=""

if [ "$(id -u)" -eq 0 ]; then
    IS_ROOT=1
    CAN_SUDO=1
    SUDO_CMD=""
elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    CAN_SUDO=1
    SUDO_CMD="sudo"
elif [ -t 0 ] && command -v sudo >/dev/null 2>&1; then
    if sudo -v 2>/dev/null; then
        CAN_SUDO=1
        SUDO_CMD="sudo"
    fi
fi

# Detect desktop user when executing through sudo
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_USER="$SUDO_USER"
    REAL_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6 2>/dev/null || echo "$HOME")"
else
    REAL_USER="$(id -un)"
    REAL_HOME="$HOME"
fi

RUN_USER_CMD=""
if [ "$IS_ROOT" -eq 1 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    RUN_USER_CMD="sudo -u $REAL_USER"
fi

echo "=== [1/8] Kernel Resilience & Runtime Sysctl Enforcement ==="
if [ "$CAN_SUDO" -eq 1 ]; then
    $SUDO_CMD /usr/lib/systemd/systemd-sysctl >/dev/null 2>&1 || $SUDO_CMD sysctl --system >/dev/null 2>&1 || true
    echo "[OK] Declarative sysctl policies synchronized across kernel, memory, and network."
else
    echo "[SKIP] Sudo privileges not available; skipping kernel sysctl updates."
    echo "       (Run with 'sudo kinoite-optimize' to enforce kernel parameters directly)."
fi

echo "=== [2/8] Systemd Tmpfiles & Declarative NoCOW Alignment ==="
if [ "$CAN_SUDO" -eq 1 ]; then
    $SUDO_CMD systemd-tmpfiles --create >/dev/null 2>&1 || true
    echo "[OK] System tmpfiles synchronized."
fi

# Ensure elegant and safe silent boot via GRUB Menu Auto-Hide
if [ "$CAN_SUDO" -eq 1 ] && command -v grub2-editenv >/dev/null 2>&1; then
    $SUDO_CMD grub2-editenv - set menu_auto_hide=2 >/dev/null 2>&1 || true
    $SUDO_CMD grub2-editenv - set boot_success=1 >/dev/null 2>&1 || true
    $SUDO_CMD grub2-editenv - set boot_indeterminate=0 >/dev/null 2>&1 || true
    if [ -d /boot/grub2 ]; then
        printf "set timeout=0\nset timeout_style=hidden\n" | $SUDO_CMD tee /boot/grub2/user.cfg >/dev/null 2>&1 || true
    fi
fi

if [ -n "$RUN_USER_CMD" ]; then
    $RUN_USER_CMD systemd-tmpfiles --user --create >/dev/null 2>&1 || true
else
    systemd-tmpfiles --user --create >/dev/null 2>&1 || true
fi
echo "[OK] User tmpfiles synchronized for $REAL_USER."

# Standardize user directories to clean ASCII names and create compatibility symlinks
declare -A USER_DIR_MAP=(
    ["Área de trabalho"]="Desktop"
    ["Documentos"]="Documents"
    ["Imagens"]="Pictures"
    ["Modelos"]="Templates"
    ["Músicas"]="Music"
    ["Público"]="Public"
    ["Vídeos"]="Videos"
)

for old_name in "${!USER_DIR_MAP[@]}"; do
    new_name="${USER_DIR_MAP[$old_name]}"
    old_path="$REAL_HOME/$old_name"
    new_path="$REAL_HOME/$new_name"

    # If new path does not exist, create it
    if [ ! -d "$new_path" ] && [ ! -L "$new_path" ]; then
        mkdir -p "$new_path" 2>/dev/null || true
    fi

    # Migrate legacy directory if it exists and is not already a symlink
    if [ -d "$old_path" ] && [ ! -L "$old_path" ]; then
        if [ ! -d "$new_path" ] || [ -z "$(ls -A "$new_path" 2>/dev/null)" ]; then
            rmdir "$new_path" 2>/dev/null || true
            mv "$old_path" "$new_path" 2>/dev/null || true
            ln -s "$new_name" "$old_path" 2>/dev/null || true
        else
            cp -a "$old_path/." "$new_path/" 2>/dev/null || true
            rm -rf "$old_path" 2>/dev/null || true
            ln -s "$new_name" "$old_path" 2>/dev/null || true
        fi
        echo "[MIGRATED] Migrated $old_name -> $new_name (with compatibility symlink)"
    elif [ ! -e "$old_path" ]; then
        ln -s "$new_name" "$old_path" 2>/dev/null || true
    fi
done

# Synchronize user-dirs.dirs with canonical ASCII paths
if [ -f "$REAL_HOME/.config/user-dirs.dirs" ]; then
    sed -i \
        -e 's|XDG_DESKTOP_DIR=.*|XDG_DESKTOP_DIR="$HOME/Desktop"|g' \
        -e 's|XDG_DOCUMENTS_DIR=.*|XDG_DOCUMENTS_DIR="$HOME/Documents"|g' \
        -e 's|XDG_DOWNLOAD_DIR=.*|XDG_DOWNLOAD_DIR="$HOME/Downloads"|g' \
        -e 's|XDG_MUSIC_DIR=.*|XDG_MUSIC_DIR="$HOME/Music"|g' \
        -e 's|XDG_PICTURES_DIR=.*|XDG_PICTURES_DIR="$HOME/Pictures"|g' \
        -e 's|XDG_PUBLICSHARE_DIR=.*|XDG_PUBLICSHARE_DIR="$HOME/Public"|g' \
        -e 's|XDG_TEMPLATES_DIR=.*|XDG_TEMPLATES_DIR="$HOME/Templates"|g' \
        -e 's|XDG_VIDEOS_DIR=.*|XDG_VIDEOS_DIR="$HOME/Videos"|g' \
        "$REAL_HOME/.config/user-dirs.dirs" 2>/dev/null || true
fi

# Ensure user-dirs.conf locks directories to avoid unwanted re-localization
if [ ! -f "$REAL_HOME/.config/user-dirs.conf" ] || ! grep -q "enabled=False" "$REAL_HOME/.config/user-dirs.conf" 2>/dev/null; then
    printf "enabled=False\nfilename_encoding=UTF-8\n" > "$REAL_HOME/.config/user-dirs.conf" 2>/dev/null || true
fi

# Synchronize Dolphin user-places.xbel bookmarks
if [ -f "$REAL_HOME/.local/share/user-places.xbel" ]; then
    sed -i \
        -e 's|%C3%81rea%20de%20trabalho|Desktop|g' \
        -e 's|file://.*/Documentos|file://'"$REAL_HOME"'/Documents|g' \
        -e 's|file://.*/M%C3%BAsicas|file://'"$REAL_HOME"'/Music|g' \
        -e 's|file://.*/Imagens|file://'"$REAL_HOME"'/Pictures|g' \
        -e 's|file://.*/V%C3%ADdeos|file://'"$REAL_HOME"'/Videos|g' \
        "$REAL_HOME/.local/share/user-places.xbel" 2>/dev/null || true
fi

NOCOW_SYSTEM_DIRS=(
    "/var/lib/libvirt/images"
    "/var/lib/containers/storage"
    "/var/lib/containers/storage/volumes"
)

NOCOW_USER_DIRS=(
    "$REAL_HOME/.local/share/libvirt/images"
    "$REAL_HOME/.local/share/gnome-boxes/images"
    "$REAL_HOME/.local/share/containers/storage"
    "$REAL_HOME/.local/share/containers/storage/volumes"
    "$REAL_HOME/.cache/rclone"
)

# Helper function to check and apply NoCOW to a directory
apply_nocow_dir() {
    local dir="$1"
    local run_cmd="$2"

    if [ -d "$dir" ]; then
        if ! $run_cmd lsattr -d "$dir" 2>/dev/null | grep -q "C"; then
            if $run_cmd chattr +C "$dir" 2>/dev/null; then
                echo "[FIXED] Applied NoCOW (+C) to directory: $dir"
            fi
        fi
    fi
}

if [ "$CAN_SUDO" -eq 1 ]; then
    for dir in "${NOCOW_SYSTEM_DIRS[@]}"; do
        apply_nocow_dir "$dir" "$SUDO_CMD"
    done
fi

for dir in "${NOCOW_USER_DIRS[@]}"; do
    apply_nocow_dir "$dir" "${RUN_USER_CMD:-}"
done

# Ensure user namespaces in podman storage inherit NoCOW
if command -v podman >/dev/null 2>&1 && [ -d "$REAL_HOME/.local/share/containers/storage" ]; then
    if [ -n "$RUN_USER_CMD" ]; then
        $RUN_USER_CMD podman unshare find "$REAL_HOME/.local/share/containers/storage" -type d -exec chattr +C {} + 2>/dev/null || true
    else
        podman unshare find "$REAL_HOME/.local/share/containers/storage" -type d -exec chattr +C {} + 2>/dev/null || true
    fi
    echo "[OK] Podman storage directory trees verified with NoCOW."
fi

# Ensure pre-existing rclone cache files are not fragmented with CoW
if [ -d "$REAL_HOME/.cache/rclone" ]; then
    RCLONE_FIXED=0
    while IFS= read -r -d '' f; do
        if ! lsattr "$f" 2>/dev/null | grep -q "C"; then
            cp --reflink=never "$f" "${f}.nocow_tmp" 2>/dev/null && mv -f "${f}.nocow_tmp" "$f" && ((RCLONE_FIXED++)) || true
        fi
    done < <(find "$REAL_HOME/.cache/rclone" -type f -print0 2>/dev/null)
    if [ "$RCLONE_FIXED" -gt 0 ]; then
        echo "[FIXED] Recreated $RCLONE_FIXED rclone cache files with atomic NoCOW inheritance."
    else
        echo "[OK] Rclone cache files verified (100% NoCOW)."
    fi
fi

# Audit and purge residual desktop .Trash-* directories on active cloud mounts
USER_UID="$(id -u "$REAL_USER" 2>/dev/null || echo "1000")"
CLOUD_BASE_DIR="/run/user/${USER_UID}/cloud"
if [ -d "$CLOUD_BASE_DIR" ] || [ -d "$REAL_HOME/Cloud" ]; then
    TRASH_FOUND=0
    for base in "$CLOUD_BASE_DIR" "$REAL_HOME/Cloud"; do
        [ -d "$base" ] || continue
        while IFS= read -r -d '' td; do
            TRASH_FOUND=1
            echo "[ACTION] Purging residual $(basename "$td") in $(dirname "$td")..."
            rm -rf "$td" 2>/dev/null || true
        done < <(find "$base" -mindepth 2 -maxdepth 2 -type d -name ".Trash-*" -print0 2>/dev/null)
    done
    if [ "$TRASH_FOUND" -eq 0 ]; then
        echo "[OK] Cloud mounts verified (zero residual .Trash-* directories)."
    else
        echo "[OK] Cloud mounts residual trash purged."
    fi
fi

# Audit and deduplicate Google Drive namespace (resolves duplicate filenames causing Dir.Remove not empty)
if command -v rclone >/dev/null 2>&1 && [ -f "$REAL_HOME/.config/rclone/rclone.conf" ]; then
    if grep -q "\[GoogleDrive\]" "$REAL_HOME/.config/rclone/rclone.conf" 2>/dev/null; then
        echo "[ACTION] Auditing Google Drive namespace for duplicate filenames..."
        DEDUPE_OUT=""
        if [ -n "$RUN_USER_CMD" ]; then
            DEDUPE_OUT=$($RUN_USER_CMD rclone dedupe --config "$REAL_HOME/.config/rclone/rclone.conf" --dedupe-mode newest --drive-pacer-min-sleep 10ms --drive-pacer-burst 100 "GoogleDrive:" 2>&1 || true)
        else
            DEDUPE_OUT=$(rclone dedupe --config "$REAL_HOME/.config/rclone/rclone.conf" --dedupe-mode newest --drive-pacer-min-sleep 10ms --drive-pacer-burst 100 "GoogleDrive:" 2>&1 || true)
        fi
        if echo "$DEDUPE_OUT" | grep -qi "delet"; then
            echo "[FIXED] Resolved duplicate files on Google Drive (clean POSIX namespace restored)."
        else
            echo "[OK] Google Drive namespace verified (zero duplicate filenames)."
        fi
    fi
fi

echo "=== [3/8] Btrfs Health & Storage Reclaim ==="
if command -v btrfs >/dev/null 2>&1 && [ -d /var/home ]; then
    echo "[STATUS] Btrfs hardware stats for /var/home:"
    btrfs device stats /var/home 2>/dev/null || true

    if [ "$CAN_SUDO" -eq 1 ]; then
        echo "[ACTION] Running balanced chunk reclamation on /var/home (-dusage=10 -musage=10)..."
        $SUDO_CMD btrfs balance start -dusage=10 -musage=10 /var/home 2>/dev/null || true
        echo "[ACTION] Executing fstrim on Btrfs filesystem..."
        $SUDO_CMD fstrim /var/home 2>/dev/null || true
        echo "[OK] Btrfs balance and TRIM completed."
    fi
fi

echo "=== [4/8] VM Disk Images Fragmentation Audit & Defrag ==="
VM_DIRS=(
    "/var/lib/libvirt/images"
    "$REAL_HOME/.local/share/libvirt/images"
    "$REAL_HOME/.local/share/gnome-boxes/images"
)

VM_FOUND=0
for vm_dir in "${VM_DIRS[@]}"; do
    if [ -d "$vm_dir" ]; then
        while IFS= read -r -d '' img; do
            [ -f "$img" ] || continue
            VM_FOUND=1
            extents=$(filefrag "$img" 2>/dev/null | awk -F': ' '{print $2}' | awk '{print $1}')
            size=$(stat -c %s "$img" 2>/dev/null || echo "0")
            size_mb=$((size / 1024 / 1024))
            if [[ "$extents" =~ ^[0-9]+$ ]]; then
                echo "[INFO] Disk image: $(basename "$img") [$vm_dir] -> ${size_mb}MB ($extents extents)"
                if [ "$extents" -gt 5000 ]; then
                    echo "[ACTION] High fragmentation detected on $(basename "$img"). Running in-place Btrfs defrag..."
                    if [ -w "$img" ]; then
                        btrfs filesystem defragment -f "$img" 2>/dev/null || true
                    elif [ "$CAN_SUDO" -eq 1 ]; then
                        $SUDO_CMD btrfs filesystem defragment -f "$img" 2>/dev/null || true
                    fi
                    new_extents=$(filefrag "$img" 2>/dev/null | awk -F': ' '{print $2}' | awk '{print $1}')
                    echo "[INFO] After defrag: $new_extents extents"
                fi
            fi
        done < <(find "$vm_dir" -maxdepth 2 -type f \( -name "*.qcow2" -o -name "*.raw" -o -name "*.img" \) -print0 2>/dev/null)
    fi
done

if [ "$VM_FOUND" -eq 0 ]; then
    echo "[OK] No virtual machine disk images found in monitored directories."
fi

echo "=== [5/8] Journald Log Retention & Cache Pruning ==="
if command -v journalctl >/dev/null 2>&1; then
    echo "[INFO] Current journal disk usage: $(journalctl --disk-usage 2>/dev/null)"
    if [ "$CAN_SUDO" -eq 1 ]; then
        $SUDO_CMD journalctl --vacuum-time=14d --vacuum-size=200M >/dev/null 2>&1 || true
        echo "[OK] System journal vacuumed (retention: 14 days, max 200M)."
    fi
    if [ -n "$RUN_USER_CMD" ]; then
        $RUN_USER_CMD journalctl --user --vacuum-time=14d --vacuum-size=100M >/dev/null 2>&1 || true
    else
        journalctl --user --vacuum-time=14d --vacuum-size=100M >/dev/null 2>&1 || true
    fi
    echo "[OK] User journal vacuumed for $REAL_USER (retention: 14 days, max 100M)."
fi

# Prune old thumbnail caches (>30 days)
if [ -d "$REAL_HOME/.cache/thumbnails" ]; then
    find "$REAL_HOME/.cache/thumbnails" -type f -atime +30 -delete 2>/dev/null || true
    echo "[OK] Stale thumbnail cache pruned in $REAL_HOME."
fi

# Prune stale Hugging Face incomplete downloads or old lock files (>30 days)
if [ -d "$REAL_HOME/.cache/huggingface/hub" ]; then
    find "$REAL_HOME/.cache/huggingface/hub" -name "*.incomplete" -delete 2>/dev/null || true
    find "$REAL_HOME/.cache/huggingface/hub" -name "*.lock" -atime +30 -delete 2>/dev/null || true
    echo "[OK] Hugging Face incomplete downloads and stale lockfiles verified."
fi

echo "=== [6/8] Flatpak & Container Hygiene ==="
if command -v flatpak >/dev/null 2>&1; then
    FLATPAK_SCOPES=()
    if [ -n "$RUN_USER_CMD" ] || [ "$CAN_SUDO" -eq 0 ]; then
        FLATPAK_SCOPES+=("user")
    fi
    if [ "$CAN_SUDO" -eq 1 ]; then
        FLATPAK_SCOPES+=("system")
    fi

    for scope in "${FLATPAK_SCOPES[@]}"; do
        if [ "$scope" = "user" ]; then
            if [ -n "$RUN_USER_CMD" ]; then
                $RUN_USER_CMD flatpak uninstall --unused -y >/dev/null 2>&1 || true
            else
                flatpak uninstall --unused -y >/dev/null 2>&1 || true
            fi
        elif [ "$scope" = "system" ]; then
            $SUDO_CMD flatpak uninstall --unused -y >/dev/null 2>&1 || true
        fi
    done
    echo "[OK] Unused Flatpak runtimes pruned."
fi

if command -v podman >/dev/null 2>&1; then
    prune_targets=("container" "volume" "image")
    for target in "${prune_targets[@]}"; do
        if [ -n "$RUN_USER_CMD" ]; then
            $RUN_USER_CMD podman "$target" prune -f >/dev/null 2>&1 || true
        else
            podman "$target" prune -f >/dev/null 2>&1 || true
        fi
        if [ "$CAN_SUDO" -eq 1 ]; then
            $SUDO_CMD podman "$target" prune -f >/dev/null 2>&1 || true
        fi
    done
    echo "[OK] Stopped containers, dangling volumes, and orphan images pruned."
fi

echo "=== [7/8] Host Kernel Arguments & Deployment Hygiene ==="
if command -v rpm-ostree >/dev/null 2>&1 && [ "$CAN_SUDO" -eq 1 ]; then
    $SUDO_CMD rpm-ostree cleanup -m >/dev/null 2>&1 || true
    echo "[OK] Deployment metadata and temporary transaction caches cleaned."

    CURRENT_KARGS=$(rpm-ostree kargs 2>/dev/null || true)
    UNWANTED_KARGS=(
        "amd_pstate=active"
        "tsc=reliable"
        "nowatchdog"
        "iommu=pt"
        "slab_nomerge"
        "vsyscall=none"
        "preempt=full"
        "page_alloc.shuffle=1"
    )
    KARGS_TO_REMOVE=()
    for k in "${UNWANTED_KARGS[@]}"; do
        if echo "$CURRENT_KARGS" | grep -q "$k"; then
            KARGS_TO_REMOVE+=("--delete-if-present=$k")
        fi
    done
    if [ ${#KARGS_TO_REMOVE[@]} -gt 0 ]; then
        echo "[ACTION] Removing unstable/obsolete kargs: ${KARGS_TO_REMOVE[*]}"
        $SUDO_CMD rpm-ostree kargs "${KARGS_TO_REMOVE[@]}"
        echo "[ALERT] Kernel arguments updated. A reboot is required to apply the pure baseline."
    else
        FEDORA_VER=$(rpm -E %fedora 2>/dev/null || echo "upstream")
        if echo "$CURRENT_KARGS" | grep -q "btusb.enable_autosuspend=0"; then
            echo "[OK] Host kernel arguments verified: Fedora ${FEDORA_VER} baseline with homologated exception (btusb.enable_autosuspend=0)."
        else
            echo "[OK] Host kernel arguments are clean (pure Fedora ${FEDORA_VER} upstream baseline)."
        fi
    fi
else
    echo "[SKIP] Sudo privileges not available; skipping rpm-ostree cleanup and kargs inspection."
fi

echo "=== [8/8] System Health & Integrity Audit ==="
# Verify CPU driver and CPPC
if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver ]; then
    driver=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver)
    echo "[STATUS] CPU Scaling Driver: $driver"
fi

# Verify Update Timers
active_timers=$(systemctl is-active bootc-fetch-apply-updates.timer flatpak-system-update.timer podman-auto-update.timer 2>/dev/null || true)
echo "[STATUS] Core System Timers: $(echo "$active_timers" | tr '\n' ' ')"

# Verify PipeWire Quantum settings
if command -v pw-metadata >/dev/null 2>&1; then
    pw_rate=$(pw-metadata -n settings 2>/dev/null | grep "clock.rate" | awk '{print $NF}' || true)
    pw_quantum=$(pw-metadata -n settings 2>/dev/null | grep "clock.quantum " | awk '{print $NF}' || true)
    if [ -n "$pw_quantum" ]; then
        echo "[STATUS] PipeWire Quantum: ${pw_quantum} @ ${pw_rate:-48000}Hz (~5.3ms latency target)"
    fi
fi

# Verify Bluetooth autosuspend exception
if [ -f /sys/module/btusb/parameters/enable_autosuspend ]; then
    bt_suspend=$(cat /sys/module/btusb/parameters/enable_autosuspend 2>/dev/null || true)
    echo "[STATUS] Bluetooth USB Autosuspend: $bt_suspend (N = zero latency handshake)"
fi

# Verify GPU Driver and Vulkan
if command -v vulkaninfo >/dev/null 2>&1; then
    vk_dev=$(vulkaninfo --summary 2>/dev/null | grep "deviceName" | head -n 1 | awk -F'=' '{print $2}' | xargs || true)
    if [ -n "$vk_dev" ]; then
        echo "[STATUS] Vulkan Device: $vk_dev"
    fi
fi

# Verify Baloo Exclusion
if [ -f /etc/xdg/baloofilerc ]; then
    if grep -q "Cloud" /etc/xdg/baloofilerc; then
        echo "[STATUS] KDE Baloo Cloud Exclusion: Active (Locked [\$ei])"
    fi
fi

# Verify GRUB Menu Auto-Hide Status
if command -v grub2-editenv >/dev/null 2>&1; then
    grub_autohide=$(grub2-editenv - list 2>/dev/null | grep "^menu_auto_hide=" | cut -d'=' -f2 || true)
    if [ "$grub_autohide" = "1" ] || [ "$grub_autohide" = "2" ]; then
        echo "[STATUS] GRUB Menu Auto-Hide: Active (Silent & Flicker-Free Boot)"
    fi
fi

# Verify Active Rclone Cloud Mounts
if command -v systemctl >/dev/null 2>&1; then
    if [ -n "$RUN_USER_CMD" ]; then
        rclone_status=$($RUN_USER_CMD systemctl --user is-active rclone@GoogleDrive.service rclone@OneDrive.service 2>/dev/null || true)
    else
        rclone_status=$(systemctl --user is-active rclone@GoogleDrive.service rclone@OneDrive.service 2>/dev/null || true)
    fi
    if [ -n "$rclone_status" ]; then
        echo "[STATUS] Rclone Cloud Mounts: $(echo "$rclone_status" | tr '\n' ' ')"
    fi
fi

# Show available storage
echo "[STATUS] Storage free space on /var/home: $(df -h /var/home | awk 'NR==2 {print $4}')"

echo "=== Optimization and Maintenance Completed Successfully ==="

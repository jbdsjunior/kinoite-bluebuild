#!/usr/bin/env bash
# kinoite-optimize - maintenance and read-only audit for the kinoite-bluebuild image.
#
#   kinoite-optimize            full maintenance (requires root)
#   kinoite-optimize --audit    read-only audit of the 7 engineering pillars
#
# Destructive operations are intentionally NOT performed here:
#   - kernel arguments are declarative (recipes/*.yml) and managed by bootc;
#   - Btrfs balance and cloud-side rclone dedupe are manual, opt-in actions;
#   - VM image defragmentation is reported, never executed automatically.
set -euo pipefail

AUDIT_ONLY=0
case "${1:-}" in
    --audit|--audit-only|-a) AUDIT_ONLY=1 ;;
    "") ;;
    *) echo "Usage: kinoite-optimize [--audit]" >&2; exit 1 ;;
esac

IS_ROOT=0
if [ "$(id -u)" -eq 0 ]; then
    IS_ROOT=1
fi

# Resolve the desktop user when running through sudo
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_USER="$SUDO_USER"
else
    REAL_USER="$(id -un)"
fi
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
[ -n "$REAL_HOME" ] || REAL_HOME="$HOME"

# Run a command as root (directly when already root)
sys() {
    if [ "$IS_ROOT" -eq 1 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

# Run a command as the desktop user (when executing under sudo)
usr() {
    if [ "$IS_ROOT" -eq 1 ] && [ "$REAL_USER" != "root" ]; then
        sudo -u "$REAL_USER" "$@"
    else
        "$@"
    fi
}

NOCOW_SYSTEM_DIRS=(
    "/var/lib/libvirt/images"
    "/var/lib/containers/storage"
    "/var/lib/containers/storage/volumes"
)

NOCOW_USER_DIRS=(
    "$REAL_HOME/.local/share/libvirt/images"
    "$REAL_HOME/.local/share/gnome-boxes/images"
    "$REAL_HOME/.local/share/containers/storage"
    "$REAL_HOME/.local/share/containers/storage/volumes"
    "$REAL_HOME/.cache/rclone"
    "$REAL_HOME/.local/state/wireplumber"
)

nocow_has_attr() {
    local dir="$1" runner="$2" attrs=""
    case "$runner" in
        sys) attrs=$(sys lsattr -d "$dir" 2>/dev/null | awk '{print $1}' || true) ;;
        usr) attrs=$(usr lsattr -d "$dir" 2>/dev/null | awk '{print $1}' || true) ;;
        *)   attrs=$(lsattr -d "$dir" 2>/dev/null | awk '{print $1}' || true) ;;
    esac
    printf '%s' "$attrs"
}

nocow_apply() {
    local dir="$1" runner="$2"
    [ -d "$dir" ] || return 0
    if nocow_has_attr "$dir" "$runner" | grep -q 'C'; then
        return 0
    fi
    case "$runner" in
        sys) sys chattr +C "$dir" 2>/dev/null || true ;;
        usr) usr chattr +C "$dir" 2>/dev/null || true ;;
    esac
    if nocow_has_attr "$dir" "$runner" | grep -q 'C'; then
        echo "[FIXED] NoCOW (+C): $dir"
    fi
}

nocow_check() {
    local dir="$1" runner="$2" attrs
    [ -d "$dir" ] || return 0
    attrs=$(nocow_has_attr "$dir" "$runner")
    if [ -z "$attrs" ]; then
        echo "[SKIP] NoCOW check without privileges: $dir"
    elif printf '%s' "$attrs" | grep -q 'C'; then
        echo "[OK] NoCOW (+C): $dir"
    else
        echo "[WARN] NoCOW (+C) missing: $dir"
    fi
}

if [ "$AUDIT_ONLY" -eq 0 ]; then
    if [ "$IS_ROOT" -eq 0 ] && ! sudo -n true 2>/dev/null; then
        echo "ERROR: maintenance requires root. Use 'sudo kinoite-optimize' or 'kinoite-optimize --audit'." >&2
        exit 1
    fi

    echo "=== [1/7] Kernel sysctl enforcement ==="
    sys /usr/lib/systemd/systemd-sysctl >/dev/null 2>&1 || true
    echo "[OK] Declarative sysctl policies applied."

    echo "=== [2/7] Tmpfiles, NoCOW and GRUB auto-hide ==="
    sys systemd-tmpfiles --create >/dev/null 2>&1 || true
    usr systemd-tmpfiles --user --create >/dev/null 2>&1 || true
    for dir in "${NOCOW_SYSTEM_DIRS[@]}"; do
        nocow_apply "$dir" sys
    done
    for dir in "${NOCOW_USER_DIRS[@]}"; do
        nocow_apply "$dir" usr
    done
    echo "[OK] Tmpfiles and NoCOW attributes synchronized."

    if command -v grub2-editenv >/dev/null 2>&1; then
        sys grub2-editenv - set menu_auto_hide=2 >/dev/null 2>&1 || true
        sys grub2-editenv - set boot_success=1 >/dev/null 2>&1 || true
        sys grub2-editenv - set boot_indeterminate=0 >/dev/null 2>&1 || true
        echo "[OK] GRUB auto-hide state enforced."
    fi

    echo "=== [3/7] Btrfs health and TRIM ==="
    if command -v btrfs >/dev/null 2>&1 && [ -d /var/home ]; then
        btrfs device stats /var/home 2>/dev/null || true
        sys fstrim /var/home 2>/dev/null || true
        echo "[OK] Btrfs device stats reported and TRIM issued."
        echo "[INFO] Manual, opt-in: sudo btrfs balance start -dusage=10 -musage=10 /var/home"
    fi

    echo "=== [4/7] VM disk image fragmentation report ==="
    VM_FOUND=0
    for vm_dir in "/var/lib/libvirt/images" "$REAL_HOME/.local/share/libvirt/images" "$REAL_HOME/.local/share/gnome-boxes/images"; do
        [ -d "$vm_dir" ] || continue
        while IFS= read -r -d '' img; do
            VM_FOUND=1
            printf '[INFO] %s -> %s\n' "$(basename "$img")" "$(filefrag "$img" 2>/dev/null | awk -F': ' '{print $2}')"
        done < <(find "$vm_dir" -maxdepth 1 -type f \( -name '*.qcow2' -o -name '*.raw' -o -name '*.img' \) -print0 2>/dev/null)
    done
    if [ "$VM_FOUND" -eq 0 ]; then
        echo "[OK] No VM disk images found."
    fi
    echo "[INFO] Manual, opt-in: sudo btrfs filesystem defragment -f <image>"

    echo "=== [5/7] Journald retention and cache pruning ==="
    sys journalctl --vacuum-time=14d --vacuum-size=200M >/dev/null 2>&1 || true
    usr journalctl --user --vacuum-time=14d --vacuum-size=100M >/dev/null 2>&1 || true
    if [ -d "$REAL_HOME/.cache/thumbnails" ]; then
        usr find "$REAL_HOME/.cache/thumbnails" -type f -atime +30 -delete 2>/dev/null || true
    fi
    echo "[OK] Journal vacuumed (system 14d/200M, user 14d/100M) and thumbnails pruned."

    echo "=== [6/7] Flatpak and container hygiene ==="
    if command -v flatpak >/dev/null 2>&1; then
        sys flatpak uninstall --unused -y >/dev/null 2>&1 || true
        usr flatpak uninstall --unused -y >/dev/null 2>&1 || true
        echo "[OK] Unused Flatpak runtimes pruned."
    fi
    if command -v podman >/dev/null 2>&1; then
        usr podman container prune -f >/dev/null 2>&1 || true
        usr podman volume prune -f >/dev/null 2>&1 || true
        usr podman image prune -f >/dev/null 2>&1 || true
        echo "[OK] Rootless Podman storage pruned."
    fi

    echo "=== [7/7] Deployment hygiene ==="
    if command -v rpm-ostree >/dev/null 2>&1; then
        sys rpm-ostree cleanup -m >/dev/null 2>&1 || true
    fi
    echo "[OK] Deployment metadata cleaned."
fi

# ---------------------------------------------------------------------------
# Read-only audit: 7 engineering pillars
# ---------------------------------------------------------------------------
echo "=========================================================="
echo "=== AUDIT - 7 Pillars of System Engineering ==="
echo "=========================================================="

echo "--- [Pillar 1/7] Supply chain & cryptographic signing ---"
if [ -f /etc/containers/policy.json ] && grep -q 'sigstore' /etc/containers/policy.json; then
    echo "[OK] Container signature policy active (/etc/containers/policy.json)."
else
    echo "[WARN] Signature policy not enforced yet (run the second 'bootc switch --enforce-container-sigpolicy')."
fi
if compgen -G '/etc/pki/containers/*.pub' >/dev/null; then
    echo "[OK] Cosign public key provisioned in /etc/pki/containers/."
fi
if command -v mokutil >/dev/null 2>&1 && mokutil --sb-state 2>/dev/null | grep -qi 'enabled'; then
    echo "[OK] Secure Boot enabled."
fi
if [ -f /usr/lib/modprobe.d/60-security-blacklist.conf ]; then
    echo "[OK] CIS modprobe blacklist installed."
fi

echo "--- [Pillar 2/7] Package baseline & no-downgrade ---"
echo "[INFO] Fedora baseline: $(rpm -E %fedora 2>/dev/null || echo upstream)."
if rpm -q fuse >/dev/null 2>&1; then
    echo "[WARN] Legacy 'fuse' (v2) package detected; prefer fuse3."
else
    echo "[OK] No legacy fuse v2 package."
fi
if command -v bootc >/dev/null 2>&1; then
    echo "[INFO] $(bootc status --json 2>/dev/null | grep -oE '"image":[^,]*' | head -n 1 || echo 'bootc status unavailable')"
fi

echo "--- [Pillar 3/7] Btrfs NoCOW, ZRAM & memory ---"
if command -v zramctl >/dev/null 2>&1; then
    echo "[OK] ZRAM: $(zramctl --output NAME,ALGORITHM,DISKSIZE,DATA --noheadings 2>/dev/null | head -n 1 || echo inactive)"
fi
echo "[OK] vm.swappiness=$(cat /proc/sys/vm/swappiness 2>/dev/null || echo n/a) (target 150), vm.page-cluster=$(cat /proc/sys/vm/page-cluster 2>/dev/null || echo n/a) (target 0)."
for p in "${NOCOW_SYSTEM_DIRS[@]}" "$REAL_HOME/.local/share/containers/storage" "$REAL_HOME/.cache/rclone"; do
    nocow_check "$p" ""
done

echo "--- [Pillar 4/7] PipeWire & WirePlumber ---"
if command -v pw-metadata >/dev/null 2>&1; then
    pw_rate=$(usr pw-metadata -n settings 2>/dev/null | awk '/clock.rate/ {print $NF}' || true)
    pw_quantum=$(usr pw-metadata -n settings 2>/dev/null | awk '/clock.quantum / {print $NF}' || true)
    if [ -n "${pw_quantum:-}" ]; then
        echo "[OK] PipeWire quantum=${pw_quantum} rate=${pw_rate:-48000} (dynamic native graph)."
    fi
fi
WP_ROUTES="$REAL_HOME/.local/state/wireplumber/default-routes"
if [ -f "$WP_ROUTES" ] && grep -q '\["headset-output", "headset-input"\]' "$WP_ROUTES" 2>/dev/null; then
    echo "[WARN] Corrupted WirePlumber default-routes detected (remove the file to heal)."
else
    echo "[OK] WirePlumber route database clean."
fi

echo "--- [Pillar 5/7] GPU, Vulkan & Wayland ---"
for node in /sys/class/drm/renderD*; do
    [ -e "$node" ] || continue
    pci="$(basename "$(readlink -f "$node/device")")"
    drv="$(basename "$(readlink -f "$node/device/driver")")"
    echo "[OK] Render node $(basename "$node") -> $pci ($drv)"
done
if [ -f /etc/cdi/amdgpu.yaml ]; then
    echo "[OK] AMD CDI present (/etc/cdi/amdgpu.yaml)."
fi
if [ -f /etc/cdi/nvidia.yaml ]; then
    echo "[OK] NVIDIA CDI present (/etc/cdi/nvidia.yaml)."
fi
if lsmod 2>/dev/null | grep -q '^nvidia_drm'; then
    echo "[WARN] nvidia_drm loaded: dual flavor expects headless NVIDIA (blacklisted)."
else
    echo "[OK] nvidia_drm absent (headless NVIDIA compute isolation)."
fi
if command -v nvidia-smi >/dev/null 2>&1; then
    echo "[OK] NVIDIA: $(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null | head -n 1 || echo unavailable)"
fi

echo "--- [Pillar 6/7] Boot resilience & recovery ---"
echo "[OK] kernel.sysrq=$(cat /proc/sys/kernel/sysrq 2>/dev/null || echo n/a) (target 1 - REISUB enabled)."
BANNED_LIST=("preempt=full" "nowatchdog" "tsc=reliable" "amd_iommu=on" "iommu=pt" "amd_pstate=active" "nvidia-drm.modeset=1")
CMDLINE="$(cat /proc/cmdline 2>/dev/null || true)"
BANNED_DETECTED=0
for b in "${BANNED_LIST[@]}"; do
    if echo "$CMDLINE" | grep -qw -- "$b"; then
        echo "[WARN] Redundant/forbidden kernel argument on boot: $b"
        BANNED_DETECTED=1
    fi
done
if [ "$BANNED_DETECTED" -eq 0 ]; then
    echo "[OK] Clean boot command line (no forbidden kargs)."
fi

echo "--- [Pillar 7/7] Timers & storage governance ---"
TIMERS=(bootc-fetch-apply-updates.timer flatpak-system-update.timer podman-auto-update.timer kinoite-maintenance.timer)
for t in "${TIMERS[@]}"; do
    printf '[%s] %s\n' "$(systemctl is-active "$t" 2>/dev/null || echo inactive)" "$t"
done
echo "[INFO] Free space on /var/home: $(df -h /var/home 2>/dev/null | awk 'NR==2 {print $4}')"

echo "=========================================================="
echo "=== Audit finished (read-only, no changes applied)     ==="
echo "=========================================================="

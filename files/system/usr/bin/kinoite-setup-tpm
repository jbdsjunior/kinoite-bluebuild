#!/usr/bin/env bash
set -euo pipefail

# Critical flow: verify root privileges
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: kinoite-setup-tpm must be run as root (use 'sudo kinoite-setup-tpm [device] [--pin | --no-pin] [--skip-recovery-key]')." >&2
    exit 1
fi

DEVICE=""
SKIP_RECOVERY=0
PIN_MODE="auto"

# Parse arguments flexibly
for arg in "$@"; do
    case "$arg" in
        --skip-recovery-key)
            SKIP_RECOVERY=1
            ;;
        --pin)
            PIN_MODE="yes"
            ;;
        --no-pin)
            PIN_MODE="no"
            ;;
        -*)
            echo "ERROR: Unknown option '$arg'" >&2
            echo "Usage: kinoite-setup-tpm [luks-block-device] [--pin | --no-pin] [--skip-recovery-key]" >&2
            exit 1
            ;;
        *)
            if [ -z "$DEVICE" ]; then
                DEVICE="$arg"
            else
                echo "ERROR: Unexpected extra argument '$arg'" >&2
                exit 1
            fi
            ;;
    esac
done

if [ -z "$DEVICE" ]; then
    echo "Scanning active system mounts to detect root LUKS partition..."
    # Probe root filesystem mount source
    ROOT_SRC="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
    if [[ "$ROOT_SRC" =~ ^/dev/mapper/ ]]; then
        DM_NAME="$(basename "$ROOT_SRC")"
        if command -v cryptsetup >/dev/null 2>&1; then
            C_DEV="$(cryptsetup status "$DM_NAME" 2>/dev/null | grep -E "^\s*device:" | awk '{print $2}' || true)"
            if [ -n "$C_DEV" ] && [ -e "$C_DEV" ]; then
                DEVICE="$C_DEV"
                echo "[INFO] Auto-detected root LUKS partition: $DEVICE"
            fi
        fi
    fi

    # Fallback probe /var/home if root is not on mapper
    if [ -z "$DEVICE" ]; then
        VAR_SRC="$(findmnt -n -o SOURCE /var/home 2>/dev/null || true)"
        if [[ "$VAR_SRC" =~ ^/dev/mapper/ ]]; then
            DM_NAME="$(basename "$VAR_SRC")"
            if command -v cryptsetup >/dev/null 2>&1; then
                C_DEV="$(cryptsetup status "$DM_NAME" 2>/dev/null | grep -E "^\s*device:" | awk '{print $2}' || true)"
                if [ -n "$C_DEV" ] && [ -e "$C_DEV" ]; then
                    DEVICE="$C_DEV"
                    echo "[INFO] Auto-detected LUKS partition from /var/home: $DEVICE"
                fi
            fi
        fi
    fi
fi

if [ -z "$DEVICE" ]; then
    echo "Usage: kinoite-setup-tpm [luks-block-device] [--pin | --no-pin] [--skip-recovery-key]"
    echo "Example: kinoite-setup-tpm /dev/nvme0n1p3 --pin"
    exit 1
fi

if [ ! -b "$DEVICE" ]; then
    echo "ERROR: Block device '$DEVICE' not found." >&2
    exit 1
fi

echo "=== [1/4] Checking LUKS2 Header on $DEVICE ==="
if ! cryptsetup isLuks "$DEVICE"; then
    echo "ERROR: $DEVICE is not a valid LUKS partition." >&2
    exit 1
fi

# Optional recovery key generation (idempotent: never accumulates orphan keys)
has_recovery_key() {
    cryptsetup luksDump --dump-json-metadata "$DEVICE" 2>/dev/null | grep -q '"systemd-recovery"' ||
        cryptsetup luksDump "$DEVICE" 2>/dev/null | grep -q 'systemd-recovery'
}

if [ "$SKIP_RECOVERY" -eq 0 ]; then
    echo "=== [2/4] Generating Offline Recovery Key ==="
    if has_recovery_key; then
        echo "[SKIP] A systemd-recovery key is already enrolled; keeping the existing one."
        echo "       (Delete it first if it was lost, or re-run with --skip-recovery-key.)"
    else
        echo "Notice: Save the printed recovery key in a secure offline location."
        if ! systemd-cryptenroll --recovery-key "$DEVICE"; then
            echo "[WARN] Recovery key enrollment failed; continuing with TPM 2.0 enrollment only." >&2
        fi
    fi
else
    echo "=== [2/4] Skipping Recovery Key Generation (--skip-recovery-key) ==="
fi

# Determine PIN policy (Apple Secure Enclave / FileVault model)
if [ "$PIN_MODE" = "auto" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
        echo ""
        echo "=== TPM 2.0 PIN policy (Apple Secure Enclave / FileVault model) ==="
        echo "With a PIN, the TPM only unseals the disk key when the PIN is typed at boot,"
        echo "preventing third parties with physical access from unlocking the system."
        if read -r -t 30 -p "Protect TPM 2.0 unlock with a security PIN? [Y/n]: " REPLY; then
            if [[ ! "$REPLY" =~ ^[Nn]$ ]]; then
                PIN_MODE="yes"
            else
                PIN_MODE="no"
            fi
        else
            echo ""
            echo "[INFO] Timeout or non-interactive terminal; continuing without a PIN..."
            PIN_MODE="no"
        fi
    else
        PIN_MODE="no"
    fi
fi

# --wipe-slot=tpm2 combined with --tpm2-device=auto enrolls first and only then
# wipes older TPM2 enrollments (excluding the new one), so a failed enrollment
# can never leave the volume without TPM unlock.
ENROLL_ARGS=("--tpm2-device=auto" "--tpm2-pcrs=7+14" "--wipe-slot=tpm2")
if [ "$PIN_MODE" = "yes" ]; then
    ENROLL_ARGS+=("--tpm2-with-pin=yes")
    echo "[INFO] Enabling two-factor authentication: TPM 2.0 + PIN (--tpm2-with-pin=yes)..."
fi

echo "=== [3/4] Enrolling AMD fTPM 2.0 bound to PCR 7 + 14 ==="
# Idempotent re-enrollment (e.g. after a UEFI firmware update): the enrollment is
# completed before any previous TPM2 slot is wiped.
if ! systemd-cryptenroll "${ENROLL_ARGS[@]}" "$DEVICE"; then
    echo "ERROR: TPM 2.0 enrollment failed. Existing LUKS unlock methods were left untouched." >&2
    exit 1
fi

# Ensure tpm2-device=auto is configured in /etc/crypttab if matching UUID is found
LUKS_UUID="$(cryptsetup luksUUID "$DEVICE" 2>/dev/null || true)"
if [ -n "$LUKS_UUID" ] && [ -f /etc/crypttab ]; then
    if grep -q "$LUKS_UUID" /etc/crypttab; then
        if ! grep "$LUKS_UUID" /etc/crypttab | grep -q "tpm2-device=auto"; then
            if grep "$LUKS_UUID" /etc/crypttab | grep -qE "none\s+[a-zA-Z0-9]"; then
                sed -i "/$LUKS_UUID/s/$/,tpm2-device=auto/" /etc/crypttab
            else
                sed -i "/$LUKS_UUID/s/$/ tpm2-device=auto/" /etc/crypttab
            fi
            echo "[OK] Appended tpm2-device=auto to /etc/crypttab entry."
        fi
    fi
fi

echo "=== [4/4] Validating Initramfs & Bootloader Integration ==="
KERNEL_VER="$(uname -r)"
INITRAMFS_TARGET="/boot/initramfs-${KERNEL_VER}.img"

if command -v bootc >/dev/null 2>&1; then
    echo "[OK] Imagem declarativa Bootc detectada. Suporte nativo a TPM2/LUKS2 pré-compilado na imagem base."
    echo "[OK] Chaves TPM2 vinculadas diretamente ao cabeçalho LUKS2 do disco."
elif command -v rpm-ostree >/dev/null 2>&1; then
    echo "Regenerating initramfs via rpm-ostree..."
    rpm-ostree initramfs --enable || true
    echo "[OK] rpm-ostree initramfs tracking enabled."
elif command -v dracut >/dev/null 2>&1; then
    echo "Running dracut with TMPDIR=/var/tmp for kernel $KERNEL_VER..."
    TMPDIR=/var/tmp dracut --kver "$KERNEL_VER" --force --reproducible "$INITRAMFS_TARGET"
    echo "[OK] Initramfs regenerated successfully at $INITRAMFS_TARGET."
fi

echo "=== TPM 2.0 Auto-Unlock Configuration Completed Successfully ==="

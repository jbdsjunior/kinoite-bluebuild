#!/usr/bin/env bash
set -euo pipefail

# kinoite-consolidate-user-dirs:
# Consolidate and merge legacy localized user directories into clean ASCII directories,
# removing legacy directories and duplicate symlinks.

TARGET_USER="${SUDO_USER:-$(id -un)}"
TARGET_HOME="$(getent passwd "$TARGET_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"

echo "=== Consolidating User Directories for $TARGET_USER ($TARGET_HOME) ==="

declare -A DIR_MAP=(
    ["Área de trabalho"]="Desktop"
    ["Documentos"]="Documents"
    ["Imagens"]="Pictures"
    ["Modelos"]="Templates"
    ["Músicas"]="Music"
    ["Público"]="Public"
    ["Vídeos"]="Videos"
)

# 1. Migrate contents from legacy directories to target ASCII directories
for old_name in "${!DIR_MAP[@]}"; do
    new_name="${DIR_MAP[$old_name]}"
    old_path="$TARGET_HOME/$old_name"
    new_path="$TARGET_HOME/$new_name"

    # Ensure target ASCII directory exists
    if [ ! -d "$new_path" ]; then
        mkdir -p "$new_path"
        echo "[CREATED] Target directory: $new_path"
    fi

    # If old path is a physical directory (not a symlink), merge files and remove it
    if [ -d "$old_path" ] && [ ! -L "$old_path" ]; then
        echo "[MERGE] Consolidating files from $old_name into $new_name..."
        if [ -n "$(ls -A "$old_path" 2>/dev/null)" ]; then
            cp -a --update=none "$old_path/." "$new_path/" 2>/dev/null || cp -a "$old_path/." "$new_path/" 2>/dev/null || true
            rm -rf "$old_path"
        else
            rmdir "$old_path" 2>/dev/null || rm -rf "$old_path" 2>/dev/null || true
        fi
        echo "[OK] Merged $old_name -> $new_name"
    # If old path is a symlink, remove it to leave the home directory clean
    elif [ -L "$old_path" ]; then
        # Preserve Área de trabalho symlink only if current shell/IDE session is actively using it
        if [ "$old_name" = "Área de trabalho" ] && pwd 2>/dev/null | grep -q "Área de trabalho"; then
            echo "[INFO] Preserved $old_name symlink for active workspace session."
        else
            rm -f "$old_path"
            echo "[CLEANED] Removed legacy symlink: $old_name"
        fi
    fi
done

# 2. Synchronize ~/.config/user-dirs.dirs to canonical ASCII paths
USER_DIRS_CONF="$TARGET_HOME/.config/user-dirs.dirs"
if [ -f "$USER_DIRS_CONF" ]; then
    sed -i \
        -e 's|XDG_DESKTOP_DIR=.*|XDG_DESKTOP_DIR="$HOME/Desktop"|g' \
        -e 's|XDG_DOCUMENTS_DIR=.*|XDG_DOCUMENTS_DIR="$HOME/Documents"|g' \
        -e 's|XDG_DOWNLOAD_DIR=.*|XDG_DOWNLOAD_DIR="$HOME/Downloads"|g' \
        -e 's|XDG_MUSIC_DIR=.*|XDG_MUSIC_DIR="$HOME/Music"|g' \
        -e 's|XDG_PICTURES_DIR=.*|XDG_PICTURES_DIR="$HOME/Pictures"|g' \
        -e 's|XDG_PUBLICSHARE_DIR=.*|XDG_PUBLICSHARE_DIR="$HOME/Public"|g' \
        -e 's|XDG_TEMPLATES_DIR=.*|XDG_TEMPLATES_DIR="$HOME/Templates"|g' \
        -e 's|XDG_VIDEOS_DIR=.*|XDG_VIDEOS_DIR="$HOME/Videos"|g' \
        "$USER_DIRS_CONF"
    echo "[OK] Updated $USER_DIRS_CONF"
fi

# 3. Enforce user-dirs.conf to disable automatic re-localization
printf "enabled=False\nfilename_encoding=UTF-8\n" > "$TARGET_HOME/.config/user-dirs.conf"

# 4. Synchronize Dolphin user-places.xbel bookmarks
XBEL_FILE="$TARGET_HOME/.local/share/user-places.xbel"
if [ -f "$XBEL_FILE" ]; then
    sed -i \
        -e 's|%C3%81rea%20de%20trabalho|Desktop|g' \
        -e 's|file://.*/Documentos|file://'"$TARGET_HOME"'/Documents|g' \
        -e 's|file://.*/M%C3%BAsicas|file://'"$TARGET_HOME"'/Music|g' \
        -e 's|file://.*/Imagens|file://'"$TARGET_HOME"'/Pictures|g' \
        -e 's|file://.*/V%C3%ADdeos|file://'"$TARGET_HOME"'/Videos|g' \
        "$XBEL_FILE"
    echo "[OK] Updated Dolphin bookmarks in $XBEL_FILE"
fi

echo "=== Consolidation complete. User directories are 100% clean ASCII! ==="

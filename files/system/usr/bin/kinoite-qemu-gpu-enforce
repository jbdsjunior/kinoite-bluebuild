#!/usr/bin/sh
set -eu

QEMU_DIR="${HOME}/.config/libvirt/qemu"
AMD_RENDER="/dev/dri/by-path/pci-0000:0c:00.0-render"

[ -d "$QEMU_DIR" ] || exit 0

for xml in "$QEMU_DIR"/*.xml; do
    [ -f "$xml" ] || continue
    # Se a VM tem aceleração 3D habilitada e o rendernode não está amarrado à AMD RX 6600 XT
    if grep -q "<gl enable=['\"]yes['\"]" "$xml" && ! grep -q "$AMD_RENDER" "$xml"; then
        sed -i -E "s|<gl enable=['\"]yes['\"][^>]*>|<gl enable='yes' rendernode='$AMD_RENDER'/>|g" "$xml"
        virsh --connect qemu:///session define "$xml" >/dev/null 2>&1 || true
    fi
done

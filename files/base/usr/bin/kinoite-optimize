#!/usr/bin/env bash
# kinoite-optimize - workstation maintenance and read-only audit.
#
# Applies the declarative policies shipped in the image (sysctl, tmpfiles, NoCOW,
# ZRAM, journal retention, container hygiene, kernel args) and reports on the
# six engineering pillars of the image contract.
set -euo pipefail

SCRIPT_NAME="${0##*/}"

MODE="apply"

# Warnings raised by the read-only audit; drives the --audit exit status.
AUDIT_WARNINGS=0

# Dynamic DRM render node detection by kernel driver (override via environment if needed).
find_drm_render_node() {
    local target_driver="$1"
    local drm_dir driver_link
    for drm_dir in /sys/class/drm/renderD*; do
        [[ -e "$drm_dir" ]] || continue
        driver_link="$(readlink -f "${drm_dir}/device/driver" 2>/dev/null || true)"
        if [[ "${driver_link##*/}" == "$target_driver" ]]; then
            printf '/dev/dri/%s\n' "${drm_dir##*/}"
            return 0
        fi
    done
    return 1
}

AMD_RENDER_PATH="${AMD_RENDER_PATH:-$(find_drm_render_node amdgpu || true)}"
NVIDIA_RENDER_PATH="${NVIDIA_RENDER_PATH:-$(find_drm_render_node nvidia || true)}"
NVIDIA_HEADLESS_MARKER="/usr/lib/modprobe.d/60-nvidia-headless.conf"

usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [--audit] [--help]

Modes:
  (default)     Apply the full 6-phase maintenance pipeline (root recommended).
  --audit, -a   Read-only audit of the 6 engineering pillars. Changes nothing.

Notes:
  * Without root privileges, privileged phases are skipped with a [SKIP] notice.
  * --audit exits non-zero when any of the six pillars reports a [WARN].
EOF
}

while (($# > 0)); do
    case "$1" in
        --audit | --audit-only | -a)
            MODE="audit"
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument '$1'" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# ---------------------------------------------------------------------------
# Context detection
# ---------------------------------------------------------------------------

ROOT_CMD=()
USER_CMD=()
CAN_SUDO=0
USER_SCOPE=1

detect_privileges() {
    if [[ "$(id -u)" -eq 0 ]]; then
        CAN_SUDO=1
    elif sudo -n true 2>/dev/null; then
        ROOT_CMD=(sudo)
        CAN_SUDO=1
    elif [[ "$MODE" == "apply" && -t 0 ]] && command -v sudo >/dev/null 2>&1; then
        # Interactive credential warm-up only for the mutating mode.
        if sudo -v 2>/dev/null; then
            ROOT_CMD=(sudo)
            CAN_SUDO=1
        fi
    fi
}

detect_target_user() {
    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        REAL_USER="$SUDO_USER"
    else
        REAL_USER="$(id -un)"
    fi

    REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6 || true)"
    if [[ -z "${REAL_HOME}" ]]; then
        if [[ "$REAL_USER" == "$(id -un)" ]]; then
            REAL_HOME="$HOME"
        else
            REAL_HOME="/home/${REAL_USER}"
        fi
    fi

    if [[ "$(id -u)" -eq 0 ]]; then
        if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
            if command -v runuser >/dev/null 2>&1; then
                USER_CMD=(runuser -u "$REAL_USER" --)
            else
                USER_CMD=(sudo -u "$REAL_USER" --)
            fi
        else
            # Root shell without a desktop user: user-scoped work is meaningless.
            USER_SCOPE=0
        fi
    fi
}

# Run a user-scoped command in the desktop user's context.
as_user() {
    "${USER_CMD[@]}" "$@"
}

# Ensure the +C (NoCOW) attribute on a directory, using the given privilege scope.
apply_nocow_dir() {
    local dir="$1"
    local scope="$2"
    local -a cmd=()

    [[ -d "$dir" ]] || return 0
    if [[ "$scope" == "root" ]]; then
        cmd=("${ROOT_CMD[@]}")
    else
        cmd=("${USER_CMD[@]}")
    fi

    if ! "${cmd[@]}" lsattr -d "$dir" 2>/dev/null | grep -q "C"; then
        if "${cmd[@]}" chattr +C "$dir" 2>/dev/null; then
            echo "[FIXED] Applied NoCOW (+C) to directory: $dir"
        fi
    fi
}

# ---------------------------------------------------------------------------
# Phase 1: tmpfiles, NoCOW alignment and cloud mount hygiene
# ---------------------------------------------------------------------------
get_nocow_user_dirs() {
    printf '%s\n' \
        "${REAL_HOME}/.local/share/libvirt/images" \
        "${REAL_HOME}/.local/share/gnome-boxes/images" \
        "${REAL_HOME}/.cache/rclone"
    if is_nvidia_headless_image; then
        printf '%s\n' "${REAL_HOME}/.nv/ComputeCache"
    fi
}

check_nocow_dir() {
    local path="$1"
    local use_sudo="${2:-0}"
    local attrs

    [[ -d "$path" ]] || return 0
    command -v lsattr >/dev/null 2>&1 || return 0

    if [[ "$use_sudo" -eq 1 && "$CAN_SUDO" -eq 1 ]]; then
        attrs="$("${ROOT_CMD[@]}" lsattr -d "$path" 2>/dev/null | awk '{print $1}' || true)"
    else
        attrs="$(lsattr -d "$path" 2>/dev/null | awk '{print $1}' || true)"
    fi

    if echo "$attrs" | grep -q "C"; then
        echo "[OK] NoCOW (+C) attribute verified on: $path"
    elif [[ -n "$attrs" ]]; then
        audit_warn "Directory without NoCOW (+C): $path"
    else
        echo "[SKIP] Insufficient permissions to inspect NoCOW (+C) on: $path (requires sudo)."
    fi
}

phase_tmpfiles_and_nocow() {
    local -a user_nocow_dirs=()
    mapfile -t user_nocow_dirs < <(get_nocow_user_dirs)

    echo "=== [1/6] Systemd Tmpfiles & Declarative NoCOW Alignment ==="
    if [[ "$CAN_SUDO" -eq 1 ]]; then
        "${ROOT_CMD[@]}" systemd-tmpfiles --create >/dev/null 2>&1 || true
        if is_nvidia_headless_image; then
            apply_nocow_dir "/var/tmp/nvidia-pm" root
        fi
        echo "[OK] System tmpfiles synchronized."
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        as_user systemd-tmpfiles --user --create >/dev/null 2>&1 || true
        echo "[OK] User tmpfiles synchronized for ${REAL_USER}."
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        local dir
        for dir in "${user_nocow_dirs[@]}"; do
            apply_nocow_dir "$dir" user
        done
    fi

    # Purge residual desktop .Trash-* directories on active cloud mounts.
    local user_uid
    user_uid="$(id -u "$REAL_USER" 2>/dev/null || echo "1000")"
    local cloud_base_dir="/run/user/${user_uid}/cloud"
    if [[ "$USER_SCOPE" -eq 1 ]] && [[ -d "$cloud_base_dir" ]]; then
        local trash_found=0
        local trash_dir
        while IFS= read -r -d '' trash_dir; do
            trash_found=1
            echo "[ACTION] Purging residual $(basename "$trash_dir") in $(dirname "$trash_dir")..."
            rm -rf "$trash_dir" 2>/dev/null || true
        done < <(find "$cloud_base_dir" -mindepth 2 -maxdepth 2 -type d -name ".Trash-*" -print0 2>/dev/null)
        if [[ "$trash_found" -eq 0 ]]; then
            echo "[OK] Cloud mounts verified (zero residual .Trash-* directories)."
        else
            echo "[OK] Cloud mount residual trash purged."
        fi
    fi
}

# ---------------------------------------------------------------------------
# Phase 2: Btrfs health and storage reclaim
# ---------------------------------------------------------------------------
phase_btrfs() {
    echo "=== [2/6] Btrfs Health & Storage Reclaim ==="
    command -v btrfs >/dev/null 2>&1 || return 0
    [[ -d /var/home ]] || return 0

    echo "[STATUS] Btrfs hardware stats for /var/home:"
    btrfs device stats /var/home 2>/dev/null || true

    if [[ "$CAN_SUDO" -eq 1 ]]; then
        echo "[ACTION] Running balanced chunk reclamation on /var/home (-dusage=10 -musage=10)..."
        "${ROOT_CMD[@]}" btrfs balance start -dusage=10 -musage=10 /var/home 2>/dev/null || true
        echo "[ACTION] Executing fstrim on Btrfs filesystem..."
        "${ROOT_CMD[@]}" fstrim /var/home 2>/dev/null || true
        echo "[OK] Btrfs balance and TRIM completed."
    fi
}

# ---------------------------------------------------------------------------
# Phase 3: VM disk image fragmentation audit, defrag & qcow2 compaction
# ---------------------------------------------------------------------------
get_file_extents() {
    local target="$1"
    local count
    count="$(filefrag "$target" 2>/dev/null | awk '{print $(NF-2)}' || true)"
    if [[ -z "$count" && "$CAN_SUDO" -eq 1 ]]; then
        count="$("${ROOT_CMD[@]}" filefrag "$target" 2>/dev/null | awk '{print $(NF-2)}' || true)"
    fi
    printf '%s\n' "$count"
}

is_vm_image_in_use() {
    local target="$1"
    if command -v fuser >/dev/null 2>&1; then
        fuser -s "$target" 2>/dev/null && return 0
        if [[ "$CAN_SUDO" -eq 1 ]]; then
            "${ROOT_CMD[@]}" fuser -s "$target" 2>/dev/null && return 0
        fi
    fi
    if command -v lsof >/dev/null 2>&1; then
        lsof "$target" >/dev/null 2>&1 && return 0
        if [[ "$CAN_SUDO" -eq 1 ]]; then
            "${ROOT_CMD[@]}" lsof "$target" >/dev/null 2>&1 && return 0
        fi
    fi
    return 1
}

compact_qcow2_image() {
    local image="$1"
    local dir tmp_image alloc_bytes avail_bytes new_alloc saved_mb
    local -a cmd=()

    [[ "$image" == *.qcow2 ]] || return 0
    command -v qemu-img >/dev/null 2>&1 || return 0

    dir="$(dirname "$image")"
    if [[ ! -w "$image" || ! -w "$dir" ]]; then
        if [[ "$CAN_SUDO" -eq 1 ]]; then
            cmd=("${ROOT_CMD[@]}")
        else
            echo "[SKIP] Insufficient permissions to compact: $(basename "$image")"
            return 0
        fi
    fi

    if is_vm_image_in_use "$image"; then
        echo "[SKIP] VM image in use; skipping compaction: $(basename "$image")"
        return 0
    fi

    if "${cmd[@]}" qemu-img snapshot -l "$image" 2>/dev/null | grep -qE '^[0-9]+'; then
        echo "[SKIP] Internal snapshots present; skipping compaction: $(basename "$image")"
        return 0
    fi

    alloc_bytes="$("${cmd[@]}" du -B1 "$image" 2>/dev/null | awk '{print $1}' || echo "0")"
    avail_bytes="$(df -B1 --output=avail "$dir" 2>/dev/null | tail -n 1 | tr -d ' ' || echo "0")"
    if [[ ! "$alloc_bytes" =~ ^[0-9]+$ || ! "$avail_bytes" =~ ^[0-9]+$ ]]; then
        return 0
    fi
    if ((avail_bytes <= alloc_bytes + 536870912)); then
        echo "[SKIP] Insufficient free space to compact: $(basename "$image")"
        return 0
    fi

    tmp_image="${image}.compact.tmp"
    "${cmd[@]}" rm -f "$tmp_image" 2>/dev/null || true

    if "${cmd[@]}" nice -n 19 ionice -c3 qemu-img convert -O qcow2 "$image" "$tmp_image" 2>/dev/null &&
        "${cmd[@]}" qemu-img check -q "$tmp_image" 2>/dev/null; then
        new_alloc="$("${cmd[@]}" du -B1 "$tmp_image" 2>/dev/null | awk '{print $1}' || echo "$alloc_bytes")"
        if [[ "$new_alloc" =~ ^[0-9]+$ ]] && ((alloc_bytes - new_alloc >= 10485760)); then
            "${cmd[@]}" chown --reference="$image" "$tmp_image" 2>/dev/null || true
            "${cmd[@]}" chmod --reference="$image" "$tmp_image" 2>/dev/null || true
            if "${cmd[@]}" mv -f "$tmp_image" "$image"; then
                saved_mb=$(((alloc_bytes - new_alloc) / 1024 / 1024))
                echo "[FIXED] Compacted $(basename "$image"): $((alloc_bytes / 1024 / 1024))MB -> $((new_alloc / 1024 / 1024))MB (saved ${saved_mb}MB)"
                return 0
            fi
        else
            echo "[OK] $(basename "$image") already compact (saved < 10MB)."
        fi
    else
        echo "[WARN] Failed to compact $(basename "$image"); keeping original intact."
    fi

    "${cmd[@]}" rm -f "$tmp_image" 2>/dev/null || true
}

phase_vm_images() {
    local vm_dirs=(
        "/var/lib/libvirt/images"
        "${REAL_HOME}/.local/share/libvirt/images"
        "${REAL_HOME}/.local/share/gnome-boxes/images"
    )
    local vm_found=0
    local vm_dir image extents size_mb new_extents

    echo "=== [3/6] VM Disk Images Audit, Defrag & Compaction ==="

    for vm_dir in "${vm_dirs[@]}"; do
        [[ -d "$vm_dir" ]] || continue
        while IFS= read -r -d '' image; do
            [[ -f "$image" ]] || continue
            vm_found=1
            extents="$(get_file_extents "$image")"
            size_mb=$((($(stat -c %s "$image" 2>/dev/null || echo "0")) / 1024 / 1024))
            if [[ "$extents" =~ ^[0-9]+$ ]]; then
                echo "[INFO] Disk image: $(basename "$image") [$vm_dir] -> ${size_mb}MB ($extents extents)"
                if [[ "$extents" -gt 5000 ]]; then
                    echo "[ACTION] High fragmentation detected on $(basename "$image"). Running in-place Btrfs defrag..."
                    if [[ -w "$image" ]]; then
                        btrfs filesystem defragment -f "$image" 2>/dev/null || true
                    elif [[ "$CAN_SUDO" -eq 1 ]]; then
                        "${ROOT_CMD[@]}" btrfs filesystem defragment -f "$image" 2>/dev/null || true
                    fi
                    new_extents="$(get_file_extents "$image")"
                    echo "[INFO] After defrag: ${new_extents} extents"
                fi
            fi
            compact_qcow2_image "$image"
        done < <(find "$vm_dir" -maxdepth 2 -type f \
            \( -name "*.qcow2" -o -name "*.raw" -o -name "*.img" \) -print0 2>/dev/null)
    done

    if [[ "$vm_found" -eq 0 ]]; then
        echo "[OK] No virtual machine disk images found in monitored directories."
    fi
}

# ---------------------------------------------------------------------------
# Phase 4: journal retention and cache pruning
# ---------------------------------------------------------------------------
phase_journal_and_caches() {
    echo "=== [4/6] Journald Log Retention & Cache Pruning ==="

    if command -v journalctl >/dev/null 2>&1; then
        echo "[INFO] Current journal disk usage: $(journalctl --disk-usage 2>/dev/null || true)"
        if [[ "$CAN_SUDO" -eq 1 ]]; then
            "${ROOT_CMD[@]}" journalctl --vacuum-time=14d --vacuum-size=200M >/dev/null 2>&1 || true
            echo "[OK] System journal vacuumed (retention: 14 days, max 200M)."
        fi
        if [[ "$USER_SCOPE" -eq 1 ]]; then
            as_user journalctl --user --vacuum-time=14d --vacuum-size=100M >/dev/null 2>&1 || true
            echo "[OK] User journal vacuumed for ${REAL_USER} (retention: 14 days, max 100M)."
        fi
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        if [[ -d "${REAL_HOME}/.cache/thumbnails" ]]; then
            find "${REAL_HOME}/.cache/thumbnails" -type f -atime +30 -delete 2>/dev/null || true
            echo "[OK] Stale thumbnail cache pruned in ${REAL_HOME}."
        fi
    fi
}

# ---------------------------------------------------------------------------
# Phase 5: container hygiene
# ---------------------------------------------------------------------------
phase_container_hygiene() {
    echo "=== [5/6] Container Hygiene ==="

    if command -v podman >/dev/null 2>&1; then
        if [[ "$USER_SCOPE" -eq 1 ]]; then
            as_user podman image prune -f >/dev/null 2>&1 || true
        fi
        if [[ "$CAN_SUDO" -eq 1 ]]; then
            "${ROOT_CMD[@]}" podman image prune -f >/dev/null 2>&1 || true
        fi
        echo "[OK] Orphan Podman images pruned (stopped containers and volumes preserved)."
    fi
}

get_unwanted_kargs() {
    printf '%s\n' \
        "amd_pstate=active" \
        "tsc=reliable" \
        "nowatchdog" \
        "amd_iommu=on" \
        "iommu=pt" \
        "slab_nomerge" \
        "vsyscall=none" \
        "preempt=full" \
        "page_alloc.shuffle=1" \
        "btusb.enable_autosuspend=0"
    # Canonical kargs use hyphenated 'nvidia-drm'; underscore variants are flagged as drift.
    if is_nvidia_headless_image || is_dual_gpu; then
        printf '%s\n' \
            "nvidia-drm.modeset=1" \
            "nvidia_drm.modeset=1" \
            "modprobe.blacklist=nvidia_drm" \
            "rd.driver.blacklist=nvidia_drm"
    fi
}

# ---------------------------------------------------------------------------
# Detection helpers shared by audit
# ---------------------------------------------------------------------------
is_dual_gpu() {
    command -v lspci >/dev/null 2>&1 || return 1
    local lspci_out
    lspci_out="$(lspci 2>/dev/null || true)"
    grep -qi "VGA.*AMD" <<<"$lspci_out" && grep -qi "NVIDIA" <<<"$lspci_out"
}

# True when the running image ships the headless-NVIDIA overlay (flavor cuda).
is_nvidia_headless_image() {
    [[ -f "$NVIDIA_HEADLESS_MARKER" ]]
}

# Audit NVIDIA headless parameters, PCI runtime PM, BAR1 aperture and systemd services.
audit_nvidia_headless() {
    if [[ -r /proc/driver/nvidia/params ]]; then
        local params key expected actual
        params="$(cat /proc/driver/nvidia/params 2>/dev/null || true)"
        for pair in \
            "DynamicPowerManagement:0" \
            "EnableS0ixPowerManagement:0" \
            "EnableResizableBar:1" \
            "PreserveVideoMemoryAllocations:1" \
            "UseKernelSuspendNotifiers:1" \
            "EnablePCIERelaxedOrderingMode:1" \
            "EnableStreamMemOPs:1" \
            'TemporaryFilePath:"/var/tmp/nvidia-pm"'; do
            key="${pair%%:*}"
            expected="${pair#*:}"
            actual="$(awk -F': ' -v k="$key" '$1 == k {print $2; exit}' <<<"$params")"
            if [[ -n "$actual" ]]; then
                if [[ "$actual" == "$expected" ]]; then
                    echo "[OK] NVIDIA param ${key}=${actual}."
                else
                    audit_warn "NVIDIA param drift: ${key}=${actual} (expected ${expected})."
                fi
            fi
        done
    else
        echo "[SKIP] /proc/driver/nvidia/params unavailable; skipping NVIDIA module parameter check."
    fi

    if [[ -r /proc/modules ]]; then
        if grep -qE '^nvidia_drm\b' /proc/modules 2>/dev/null; then
            audit_warn "nvidia_drm kernel module is loaded on a headless-NVIDIA image."
        else
            echo "[OK] nvidia_drm kernel module is not loaded."
        fi
    fi

    local pci_dev vendor class ctrl d3cold found_nv_pci=0
    for pci_dev in /sys/bus/pci/devices/*; do
        [[ -e "$pci_dev" ]] || continue
        vendor="$(cat "${pci_dev}/vendor" 2>/dev/null || true)"
        class="$(cat "${pci_dev}/class" 2>/dev/null || true)"
        [[ "$vendor" == "0x10de" && "$class" =~ ^0x030[02]00$ ]] || continue
        found_nv_pci=1
        ctrl="$(cat "${pci_dev}/power/control" 2>/dev/null || echo "N/A")"
        d3cold="$(cat "${pci_dev}/d3cold_allowed" 2>/dev/null || echo "N/A")"
        if [[ "$ctrl" == "on" && ( "$d3cold" == "0" || "$d3cold" == "N/A" ) ]]; then
            echo "[OK] NVIDIA PCI PM (${pci_dev##*/}): power/control=${ctrl}, d3cold_allowed=${d3cold}."
        else
            audit_warn "NVIDIA PCI PM drift (${pci_dev##*/}): power/control=${ctrl} (expected on), d3cold_allowed=${d3cold} (expected 0)."
        fi

        if [[ -r "${pci_dev}/resource" ]]; then
            local bar_bytes=0 r_start r_end _rest sz bar_gib bar_mib
            while read -r r_start r_end _rest; do
                [[ "$r_start" == 0x* && "$r_end" == 0x* ]] || continue
                if ((r_end > r_start)); then
                    sz=$((r_end - r_start + 1))
                    ((sz > bar_bytes)) && bar_bytes="$sz"
                fi
            done <"${pci_dev}/resource"
            if ((bar_bytes >= 4294967296)); then
                bar_gib=$((bar_bytes / 1073741824))
                echo "[OK] NVIDIA BAR1 aperture (${pci_dev##*/}): ${bar_gib} GiB (Resizable BAR active in UEFI)."
            elif ((bar_bytes > 0)); then
                bar_mib=$((bar_bytes / 1048576))
                audit_warn "NVIDIA BAR1 aperture (${pci_dev##*/}) is ${bar_mib} MiB (enable Above 4G Decoding & Re-Size BAR in UEFI)."
            fi
        fi

        if [[ -r "${pci_dev}/current_link_speed" && -r "${pci_dev}/max_link_speed" ]]; then
            local cur_spd max_spd cur_wid max_wid
            cur_spd="$(cat "${pci_dev}/current_link_speed" 2>/dev/null || echo "?")"
            max_spd="$(cat "${pci_dev}/max_link_speed" 2>/dev/null || echo "?")"
            cur_wid="$(cat "${pci_dev}/current_link_width" 2>/dev/null || echo "?")"
            max_wid="$(cat "${pci_dev}/max_link_width" 2>/dev/null || echo "?")"
            echo "[INFO] NVIDIA PCIe link (${pci_dev##*/}): ${cur_spd} x${cur_wid} (max ${max_spd} x${max_wid})."
        fi
    done
    if [[ "$found_nv_pci" -eq 0 ]]; then
        echo "[SKIP] No NVIDIA GPU PCI device detected in /sys/bus/pci/devices."
    fi

    if command -v systemctl >/dev/null 2>&1; then
        local persistenced_state powerd_state tune_state
        if persistenced_state="$(systemctl is-active nvidia-persistenced.service 2>/dev/null)"; then
            echo "[OK] nvidia-persistenced.service is ${persistenced_state}."
        elif systemctl list-unit-files nvidia-persistenced.service >/dev/null 2>&1; then
            audit_warn "nvidia-persistenced.service is ${persistenced_state:-inactive} (expected active)."
        fi
        if powerd_state="$(systemctl is-active nvidia-powerd.service 2>/dev/null)"; then
            audit_warn "nvidia-powerd.service is ${powerd_state} (expected masked/inactive on desktop)."
        elif systemctl list-unit-files nvidia-powerd.service >/dev/null 2>&1; then
            echo "[OK] nvidia-powerd.service is inactive/masked."
        fi
        if [[ -x /usr/bin/kinoite-nvidia-tune ]]; then
            if tune_state="$(systemctl is-active nvidia-tune.service 2>/dev/null)"; then
                echo "[OK] nvidia-tune.service is ${tune_state}."
            elif systemctl list-unit-files nvidia-tune.service >/dev/null 2>&1; then
                audit_warn "nvidia-tune.service is ${tune_state:-inactive} (expected active)."
            fi
        fi
    fi

    if command -v kinoite-nvidia-tune >/dev/null 2>&1; then
        kinoite-nvidia-tune status 2>/dev/null | sed 's/^/[INFO] /' || true
    fi
}

# Audit required kernel arguments and CPU/TuneD power state.
audit_required_kargs_and_power() {
    local cmdline="$1"
    local -a required_kargs=("pcie_port_pm=off")
    if is_nvidia_headless_image; then
        required_kargs+=(
            "initcall_blacklist=simpledrm_platform_driver_init"
            "rd.driver.blacklist=nvidia-drm"
            "modprobe.blacklist=nvidia-drm"
            "rd.driver.blacklist=nouveau"
            "modprobe.blacklist=nouveau"
        )
    fi

    local req missing_kargs=0
    for req in "${required_kargs[@]}"; do
        if ! grep -qwF "$req" <<<"$cmdline"; then
            audit_warn "Missing required karg on boot line: $req"
            missing_kargs=1
        fi
    done
    if [[ "$missing_kargs" -eq 0 ]]; then
        echo "[OK] Required power/isolation kargs present (${required_kargs[*]})."
    fi

    local pstate_driver epp
    pstate_driver="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || true)"
    epp="$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || true)"
    if [[ -n "$pstate_driver" ]]; then
        echo "[OK] CPU power scaling: driver=${pstate_driver}, epp=${epp:-N/A}."
    fi

    if command -v tuned-adm >/dev/null 2>&1; then
        local tuned_profile
        tuned_profile="$(tuned-adm active 2>/dev/null | sed -n 's/^Current active profile: //p' | head -n 1 || true)"
        if [[ "$tuned_profile" == "throughput-performance" ]]; then
            audit_warn "TuneD profile 'throughput-performance' active (prefer 'balanced' on Btrfs/desktop)."
        elif [[ -n "$tuned_profile" ]]; then
            echo "[OK] TuneD active profile: ${tuned_profile}."
        fi
    fi
}

# ---------------------------------------------------------------------------
# Audit: six engineering pillars
# ---------------------------------------------------------------------------
audit_warn() {
    echo "[WARN] $*"
    AUDIT_WARNINGS=$((AUDIT_WARNINGS + 1))
}

audit_pillars() {
    local fedora_version

    AUDIT_WARNINGS=0

    echo "--- [Pillar 1/6] Supply Chain, Keys & Signing ---"
    if command -v mokutil >/dev/null 2>&1; then
        local sb_state enrolled
        sb_state="$(mokutil --sb-state 2>/dev/null || true)"
        if grep -qi "enabled" <<<"$sb_state"; then
            enrolled="$(mokutil --list-enrolled 2>/dev/null || true)"
            if grep -qi "ublue" <<<"$enrolled"; then
                echo "[OK] Secure Boot enabled with the enrolled ublue MOK certificate."
            else
                echo "[OK] Secure Boot enabled (factory/standard key set)."
            fi
        else
            echo "[INFO] Secure Boot disabled in firmware (Setup/Standard mode)."
        fi
    fi
    if [[ -f /etc/pki/akmods/certs/akmods-ublue.der ]]; then
        echo "[OK] Versioned MOK certificate present in /etc/pki/akmods/certs/."
    fi
    if [[ -f /etc/containers/policy.json ]] && grep -q "sigstoreSigned" /etc/containers/policy.json; then
        echo "[OK] Cosign sigstore policy configured in /etc/containers/policy.json."
    fi
    if [[ -f /usr/lib/bootc/install/20-kinoite.toml ]]; then
        if grep -qE '^\s*enforce-container-sigpolicy\s*=\s*true' /usr/lib/bootc/install/20-kinoite.toml; then
            echo "[OK] Bootc install policy enforces container signature verification (20-kinoite.toml)."
        else
            audit_warn "20-kinoite.toml present without enforce-container-sigpolicy = true."
        fi
    fi

    echo "--- [Pillar 2/6] Package Resilience & Zero Downgrade ---"
    fedora_version="$(rpm -E %fedora 2>/dev/null || echo "upstream")"
    echo "[INFO] Fedora baseline: ${fedora_version} (native bootc/rpm-ostree)."
    local repo_dir repo_file
    for repo_dir in /etc/yum.repos.d /usr/share/dnf5/repos.d; do
        [[ -d "$repo_dir" ]] || continue
        for repo_file in "${repo_dir}/terra.repo" "${repo_dir}/tailscale.repo" "${repo_dir}"/rpmfusion-*.repo; do
            [[ -f "$repo_file" ]] || continue
            if grep -qE '^\s*enabled\s*=\s*1' "$repo_file"; then
                audit_warn "Transient third-party repo enabled on host: ${repo_file}"
            fi
        done
    done
    if command -v rpm >/dev/null 2>&1; then
        local unwanted_pkg
        for unwanted_pkg in firefox plasma-discover-rpm-ostree plasma-discover-notifier; do
            if rpm -q "$unwanted_pkg" >/dev/null 2>&1; then
                audit_warn "Debloated RPM package present on host: ${unwanted_pkg}"
            fi
        done
        local kde_ver kwin_ver kscreen_ver
        kde_ver="$(rpm -q --qf '%{VERSION}' plasma-desktop 2>/dev/null || true)"
        kwin_ver="$(rpm -q --qf '%{VERSION}' kwin 2>/dev/null || true)"
        kscreen_ver="$(rpm -q --qf '%{VERSION}' kscreen 2>/dev/null || true)"
        if [[ -n "$kde_ver" && -n "$kwin_ver" && -n "$kscreen_ver" ]]; then
            if [[ "$kde_ver" == "$kwin_ver" && "$kde_ver" == "$kscreen_ver" ]]; then
                echo "[OK] KDE Plasma versions aligned (${kde_ver})."
            else
                audit_warn "KDE version mismatch: plasma-desktop=${kde_ver}, kwin=${kwin_ver}, kscreen=${kscreen_ver}."
            fi
        fi
    fi

    echo "--- [Pillar 3/6] Btrfs NoCOW Storage & ZRAM ---"
    if command -v zramctl >/dev/null 2>&1; then
        local zram_info
        zram_info="$(zramctl --output NAME,ALGORITHM,DISKSIZE,DATA --noheadings 2>/dev/null | head -n 1 || true)"
        if [[ -n "$zram_info" ]]; then
            echo "[OK] ZRAM active: $zram_info"
        fi
    fi

    local swappiness page_cluster
    swappiness="$(cat /proc/sys/vm/swappiness 2>/dev/null || echo "N/A")"
    page_cluster="$(cat /proc/sys/vm/page-cluster 2>/dev/null || echo "N/A")"
    if [[ "$swappiness" == "150" && "$page_cluster" == "0" ]]; then
        echo "[OK] VM parameters: vm.swappiness=${swappiness} (target 150), vm.page-cluster=${page_cluster} (target 0)."
    else
        audit_warn "VM parameter drift: vm.swappiness=${swappiness} (target 150), vm.page-cluster=${page_cluster} (target 0)."
    fi

    local -a nocow_paths=()
    mapfile -t nocow_paths < <(get_nocow_user_dirs)
    local path
    for path in "${nocow_paths[@]}"; do
        check_nocow_dir "$path" 1
    done
    if is_nvidia_headless_image; then
        check_nocow_dir "/var/tmp/nvidia-pm" 1
    fi

    echo "--- [Pillar 4/6] GPU Acceleration, Vulkan & Wayland ---"
    if [[ -f /etc/cdi/amdgpu.yaml ]]; then
        echo "[OK] AMD Container Device Interface (CDI) present (/etc/cdi/amdgpu.yaml)."
    fi
    if [[ -n "${AMD_RENDER_PATH:-}" && -e "$AMD_RENDER_PATH" ]]; then
        echo "[OK] AMD DRM render node present (${AMD_RENDER_PATH})."
    else
        audit_warn "AMD DRM render node not detected via amdgpu driver."
    fi
    if [[ -e /dev/dri/primary-render ]]; then
        echo "[OK] Deterministic /dev/dri/primary-render symlink pointing to $(readlink /dev/dri/primary-render)."
    fi
    if [[ -f /etc/cdi/nvidia.yaml || -f /run/cdi/nvidia.yaml || -f /var/run/cdi/nvidia.yaml ]]; then
        echo "[OK] NVIDIA Container Device Interface (CDI) present and active."
    fi
    if command -v nvidia-smi >/dev/null 2>&1; then
        local nv_gpu
        nv_gpu="$(nvidia-smi --query-gpu=name,driver_version,memory.total \
            --format=csv,noheader,nounits 2>/dev/null | head -n 1 || true)"
        if [[ -n "$nv_gpu" ]]; then
            echo "[OK] NVIDIA GPU: $nv_gpu (headless compute/AI)."
        fi
    fi

    if [[ -n "${NVIDIA_RENDER_PATH:-}" && -e "$NVIDIA_RENDER_PATH" ]]; then
        if is_nvidia_headless_image; then
            audit_warn "NVIDIA graphics render node detected (${NVIDIA_RENDER_PATH}) on a headless-NVIDIA image."
            echo "       nvidia-drm blacklisting is not effective; QEMU/GNOME Boxes may be affected."
        else
            echo "[INFO] NVIDIA graphics render node detected (${NVIDIA_RENDER_PATH}); expected on the kinoite-amd flavor."
        fi
    else
        echo "[OK] Clean graphics isolation: the AMD GPU exclusively owns DRM render nodes."
    fi
    if is_nvidia_headless_image; then
        audit_nvidia_headless
    fi

    echo "--- [Pillar 5/6] Boot Resilience, SysRq REISUB & Sulogin ---"
    local sysrq
    sysrq="$(cat /proc/sys/kernel/sysrq 2>/dev/null || echo "N/A")"
    if [[ "$sysrq" == "1" ]]; then
        echo "[OK] Kernel SysRq: ${sysrq} (target 1 - safe REISUB enabled)."
    else
        audit_warn "Kernel SysRq mismatch: ${sysrq} (expected 1 for safe REISUB)."
    fi

    local cmdline banned detected=0
    local -a banned_list=()
    cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
    mapfile -t banned_list < <(get_unwanted_kargs)
    for banned in "${banned_list[@]}"; do
        if grep -qwF "$banned" <<<"$cmdline"; then
            audit_warn "Redundant/unsafe karg detected on the boot line: $banned"
            detected=1
        fi
    done
    if [[ "$detected" -eq 0 ]]; then
        echo "[OK] Clean boot line (zero redundant kargs detected)."
    fi
    audit_required_kargs_and_power "$cmdline"

    # Sulogin: root authentication on emergency/rescue consoles (AGENTS §7).
    local root_state
    if command -v passwd >/dev/null 2>&1 &&
        root_state="$(passwd -S root 2>/dev/null | awk '{print $2}')" &&
        [[ -n "$root_state" ]]; then
        case "$root_state" in
            P)
                echo "[OK] Root password set: sulogin protects emergency/rescue consoles."
                ;;
            NP)
                audit_warn "Root account has no password: sulogin would grant an unauthenticated emergency shell."
                ;;
            L)
                audit_warn "Root account is locked: sulogin cannot authenticate recovery sessions (set a root password to keep recovery access)."
                ;;
            *)
                echo "[INFO] Root account state '${root_state}': sulogin enforcement not verifiable."
                ;;
        esac
    else
        echo "[SKIP] Root account state unavailable (run as root to verify sulogin enforcement)."
    fi

    echo "--- [Pillar 6/6] Maintenance Timers & Storage ---"
    local required_timers=(
        "bootc-fetch-apply-updates.timer"
        "flatpak-system-update.timer"
    )
    local timer_states
    if timer_states="$(systemctl is-active "${required_timers[@]}" 2>/dev/null)" ||
        [[ -n "$timer_states" ]]; then
        local idx=0 state inactive_timers=()
        while IFS= read -r state; do
            if [[ "$state" != "active" ]]; then
                inactive_timers+=("${required_timers[$idx]}(${state:-unknown})")
            fi
            idx=$((idx + 1))
        done <<<"$timer_states"
        if [[ ${#inactive_timers[@]} -gt 0 ]]; then
            audit_warn "Inactive update timer(s): ${inactive_timers[*]}"
        else
            echo "[OK] System update timers: all ${#required_timers[@]} active."
        fi
    else
        echo "[SKIP] Timer state unavailable (systemd not reachable from this session)."
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        local user_uid runtime_dir
        user_uid="$(id -u "$REAL_USER" 2>/dev/null || true)"
        runtime_dir="/run/user/${user_uid}"
        if [[ -n "$user_uid" && -S "${runtime_dir}/systemd/private" ]]; then
            local user_units=(
                "flatpak-user-update.timer"
            )
            local u_states u_idx=0 u_state inactive_user=()
            u_states="$(as_user env XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="unix:path=${runtime_dir}/bus" systemctl --user is-active "${user_units[@]}" 2>/dev/null || true)"
            if [[ -n "$u_states" ]]; then
                while IFS= read -r u_state; do
                    if [[ "$u_state" != "active" ]]; then
                        inactive_user+=("${user_units[$u_idx]}(${u_state:-unknown})")
                    fi
                    u_idx=$((u_idx + 1))
                done <<<"$u_states"
                if [[ ${#inactive_user[@]} -gt 0 ]]; then
                    audit_warn "Inactive user unit(s): ${inactive_user[*]}"
                else
                    echo "[OK] User update timers: all ${#user_units[@]} active."
                fi
            fi
        fi
    fi

    if [[ -d /var/home ]]; then
        echo "[STATUS] Free space on /var/home: $(df -h /var/home | awk 'NR==2 {print $4}')"
    fi
    if command -v flatpak >/dev/null 2>&1; then
        local system_remotes
        system_remotes="$(flatpak remotes --system --columns=name 2>/dev/null || true)"
        if grep -qxE 'fedora|fedora-testing' <<<"$system_remotes"; then
            audit_warn "Residual Fedora Flatpak remote detected; only Flathub should be active."
        elif [[ -n "$system_remotes" ]]; then
            echo "[OK] System Flatpak remotes clean (no Fedora remote active)."
        fi
    fi
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
main() {
    detect_privileges
    detect_target_user

    if [[ "$MODE" == "apply" ]]; then
        phase_tmpfiles_and_nocow
        phase_btrfs
        phase_vm_images
        phase_journal_and_caches
        phase_container_hygiene

        echo "=== [6/6] System Health & Integrity Audit ==="
        audit_pillars
        if [[ "$AUDIT_WARNINGS" -gt 0 ]]; then
            echo "=== Optimization completed with ${AUDIT_WARNINGS} audit warning(s) ==="
        else
            echo "=== Optimization and Maintenance Completed Successfully ==="
        fi
        return 0
    fi

    echo "============================================================="
    echo "=== [AUDIT] Six Engineering Pillars of a Professional OS"
    echo "============================================================="
    audit_pillars
    echo "============================================================="
    if [[ "$AUDIT_WARNINGS" -gt 0 ]]; then
        echo "=== Six-Pillar Audit Failed: ${AUDIT_WARNINGS} warning(s) detected"
        echo "============================================================="
        return 1
    fi
    echo "=== Six-Pillar Audit Completed Successfully"
    echo "============================================================="
    return 0
}

main "$@"

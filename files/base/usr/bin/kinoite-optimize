#!/usr/bin/env bash
# kinoite-optimize - workstation maintenance and read-only five-pillar audit.
set -euo pipefail

SCRIPT_NAME="${0##*/}"
MODE="apply"
AUDIT_WARNINGS=0
NEW_CONTRACT=0
[[ -f /usr/lib/sysctl.d/90-kinoite.conf ]] && NEW_CONTRACT=1

NVIDIA_HEADLESS_MARKER="/usr/lib/modprobe.d/60-nvidia-headless.conf"
NOCOW_SYSTEM_DIRS=(
    "/var/lib/libvirt/images"
    "/var/lib/containers/storage"
    "/var/lib/containers/storage/volumes"
)
LEGACY_HOST_RESIDUES=(
    "/etc/sysctl.d/90-kernel-tuning.conf"
    "/etc/sysctl.d/90-memory-fs-tuning.conf"
    "/etc/sysctl.d/90-network-tuning.conf"
    "/var/lib/kinoite-boot-init-v4-done"
    "/etc/cdi/amdgpu.yaml"
    "/var/lib/flatpak/overrides/ai.jan.Jan"
    "/var/lib/flatpak/overrides/com.visualstudio.code"
    "/var/lib/flatpak/overrides/com.google.Chrome"
    "/var/lib/flatpak/overrides/org.mozilla.firefox"
)

find_drm_render_node() {
    local target_driver="$1"
    local drm_dir driver_link
    for drm_dir in /sys/class/drm/renderD*; do
        [[ -e "$drm_dir" ]] || continue
        driver_link="$(readlink -f "${drm_dir}/device/driver" 2>/dev/null || true)"
        if [[ "${driver_link##*/}" == "$target_driver" ]]; then
            printf '/dev/dri/%s\n' "${drm_dir##*/}"
            return 0
        fi
    done
    return 1
}

AMD_RENDER_PATH="${AMD_RENDER_PATH:-$(find_drm_render_node amdgpu || true)}"
NVIDIA_RENDER_PATH="${NVIDIA_RENDER_PATH:-$(find_drm_render_node nvidia || true)}"

usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [--audit] [--help]

Modes:
  (default)     Apply safe maintenance (sysctl, tmpfiles, NoCOW, Btrfs, VM defrag, caches).
  --audit, -a   Read-only audit of the 5 engineering pillars. Changes nothing.

Notes:
  * Without root privileges, privileged steps are skipped with a [SKIP] notice.
  * --audit exits non-zero when any active pillar reports a [WARN].
EOF
}

while (($# > 0)); do
    case "$1" in
        --audit | --audit-only | -a) MODE="audit" ;;
        -h | --help) usage; exit 0 ;;
        *) echo "ERROR: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

ROOT_CMD=()
USER_CMD=()
CAN_SUDO=0
USER_SCOPE=1

detect_privileges() {
    if [[ "$(id -u)" -eq 0 ]]; then
        CAN_SUDO=1
    elif sudo -n true 2>/dev/null; then
        ROOT_CMD=(sudo)
        CAN_SUDO=1
    elif [[ "$MODE" == "apply" && -t 0 ]] && command -v sudo >/dev/null 2>&1; then
        if sudo -v 2>/dev/null; then
            ROOT_CMD=(sudo)
            CAN_SUDO=1
        fi
    fi
}

detect_target_user() {
    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        REAL_USER="$SUDO_USER"
    else
        REAL_USER="$(id -un)"
    fi

    REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6 || true)"
    if [[ -z "${REAL_HOME}" ]]; then
        REAL_HOME=$([[ "$REAL_USER" == "$(id -un)" ]] && printf '%s' "$HOME" || printf '/home/%s' "$REAL_USER")
    fi

    if [[ "$(id -u)" -eq 0 ]]; then
        if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
            USER_CMD=(runuser -u "$REAL_USER" --)
        else
            USER_SCOPE=0
        fi
    fi
}

as_user() { "${USER_CMD[@]}" "$@"; }
as_root() { "${ROOT_CMD[@]}" "$@"; }

get_nocow_user_dirs() {
    printf '%s\n' \
        "${REAL_HOME}/.local/share/libvirt/images" \
        "${REAL_HOME}/.local/share/gnome-boxes/images" \
        "${REAL_HOME}/.local/share/containers/storage" \
        "${REAL_HOME}/.local/share/containers/storage/volumes" \
        "${REAL_HOME}/.cache/rclone"
}

is_dual_gpu() {
    command -v lspci >/dev/null 2>&1 || return 1
    lspci 2>/dev/null | grep -qi "VGA.*AMD" && lspci 2>/dev/null | grep -qi "NVIDIA"
}

is_nvidia_headless_image() { [[ -f "$NVIDIA_HEADLESS_MARKER" ]]; }

get_unwanted_kargs() {
    printf '%s\n' \
        "initcall_blacklist=simpledrm_platform_driver_init" \
        "amd_pstate=active" \
        "tsc=reliable" \
        "nowatchdog" \
        "amd_iommu=on" \
        "iommu=pt" \
        "slab_nomerge" \
        "vsyscall=none" \
        "preempt=full" \
        "page_alloc.shuffle=1" \
        "btusb.enable_autosuspend=0"
    if is_nvidia_headless_image || is_dual_gpu; then
        printf '%s\n' \
            "nvidia-drm.modeset=1" \
            "nvidia_drm.modeset=1" \
            "modprobe.blacklist=nvidia_drm" \
            "rd.driver.blacklist=nvidia_drm"
    fi
}

apply_nocow_dir() {
    local dir="$1" scope="$2"
    [[ -d "$dir" ]] || return 0
    local -a cmd=()
    [[ "$scope" == "root" ]] && cmd=("${ROOT_CMD[@]}") || cmd=("${USER_CMD[@]}")
    if ! "${cmd[@]}" lsattr -d "$dir" 2>/dev/null | grep -q "C"; then
        if "${cmd[@]}" chattr +C "$dir" 2>/dev/null; then
            echo "[FIXED] Applied NoCOW (+C) to directory: $dir"
        fi
    fi
}

cleanup_legacy_host_residues() {
    [[ "$NEW_CONTRACT" -eq 1 && "$CAN_SUDO" -eq 1 ]] || return 0
    local f cleaned=0
    for f in /etc/sysctl.d/90-kernel-tuning.conf /etc/sysctl.d/90-memory-fs-tuning.conf /etc/sysctl.d/90-network-tuning.conf; do
        if [[ -L "$f" ]] && [[ "$(readlink "$f" 2>/dev/null || true)" == /usr/lib/sysctl.d/90-* ]]; then
            as_root rm -f "$f"
            cleaned=$((cleaned + 1))
        fi
    done
    for f in \
        /var/lib/kinoite-boot-init-v4-done \
        /etc/cdi/amdgpu.yaml \
        /var/lib/flatpak/overrides/ai.jan.Jan \
        /var/lib/flatpak/overrides/com.visualstudio.code \
        /var/lib/flatpak/overrides/com.google.Chrome \
        /var/lib/flatpak/overrides/org.mozilla.firefox; do
        if [[ -e "$f" || -L "$f" ]]; then
            as_root rm -f "$f"
            cleaned=$((cleaned + 1))
        fi
    done
    [[ "$cleaned" -gt 0 ]] && echo "[FIXED] Removed ${cleaned} legacy host residue(s)."
}

phase_sysctl_and_tmpfiles() {
    echo "=== [1/5] Sysctl, Tmpfiles & Host Hygiene ==="
    if [[ "$CAN_SUDO" -eq 1 ]]; then
        cleanup_legacy_host_residues
        as_root /usr/lib/systemd/systemd-sysctl >/dev/null 2>&1 || as_root sysctl --system >/dev/null 2>&1 || true
        as_root systemd-tmpfiles --create >/dev/null 2>&1 || true
        echo "[OK] System sysctl and tmpfiles synchronized."
    else
        echo "[SKIP] Sudo unavailable; skipping system sysctl/tmpfiles."
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        as_user systemd-tmpfiles --user --create >/dev/null 2>&1 || true
        echo "[OK] User tmpfiles synchronized for ${REAL_USER}."
    fi
}

phase_nocow_and_cloud() {
    echo "=== [2/5] Btrfs NoCOW & Cloud Mount Hygiene ==="
    local dir
    if [[ "$CAN_SUDO" -eq 1 ]]; then
        for dir in "${NOCOW_SYSTEM_DIRS[@]}"; do
            apply_nocow_dir "$dir" root
        done
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        local -a user_nocow_dirs=()
        mapfile -t user_nocow_dirs < <(get_nocow_user_dirs)
        for dir in "${user_nocow_dirs[@]}"; do
            apply_nocow_dir "$dir" user
        done

        if command -v podman >/dev/null 2>&1 && [[ -d "${REAL_HOME}/.local/share/containers/storage" ]]; then
            as_user podman unshare find "${REAL_HOME}/.local/share/containers/storage" \
                -type d -exec chattr +C {} + 2>/dev/null || true
            echo "[OK] Podman storage directory trees verified with NoCOW."
        fi

        if [[ -d "${REAL_HOME}/.cache/rclone" ]]; then
            local rclone_fixed=0 attrs file line
            while IFS= read -r line; do
                attrs="${line%% *}"
                file="${line#* }"
                if [[ -f "$file" && "$attrs" != *C* ]]; then
                    cp --reflink=never "$file" "${file}.nocow_tmp" 2>/dev/null &&
                        mv -f "${file}.nocow_tmp" "$file" &&
                        rclone_fixed=$((rclone_fixed + 1))
                fi
            done < <(find "${REAL_HOME}/.cache/rclone" -type f -exec lsattr {} + 2>/dev/null || true)
            echo "[OK] Rclone cache NoCOW check completed (${rclone_fixed} fixed)."
        fi

        local cloud_base="/run/user/$(id -u "$REAL_USER" 2>/dev/null || echo 1000)/cloud"
        if [[ -d "$cloud_base" ]]; then
            local trash_dir
            while IFS= read -r -d '' trash_dir; do
                rm -rf "$trash_dir" 2>/dev/null || true
            done < <(find "$cloud_base" -mindepth 2 -maxdepth 2 -type d -name ".Trash-*" -print0 2>/dev/null)
            echo "[OK] Cloud mount residual trash verified."
        fi
    fi
}

phase_btrfs_and_vms() {
    echo "=== [3/5] Btrfs Health & VM Image Fragmentation ==="
    if command -v btrfs >/dev/null 2>&1 && [[ -d /var/home ]]; then
        btrfs device stats /var/home 2>/dev/null || true
        if [[ "$CAN_SUDO" -eq 1 ]]; then
            as_root btrfs balance start -dusage=10 -musage=10 /var/home 2>/dev/null || true
            as_root fstrim /var/home 2>/dev/null || true
            echo "[OK] Btrfs balance and TRIM completed."
        fi
    fi

    local vm_dirs=("/var/lib/libvirt/images" "${REAL_HOME}/.local/share/libvirt/images" "${REAL_HOME}/.local/share/gnome-boxes/images")
    local vm_found=0 vm_dir image extents size_mb
    for vm_dir in "${vm_dirs[@]}"; do
        [[ -d "$vm_dir" ]] || continue
        while IFS= read -r -d '' image; do
            [[ -f "$image" ]] || continue
            vm_found=1
            extents="$(filefrag "$image" 2>/dev/null | awk '{print $(NF-2)}' || true)"
            [[ -z "$extents" && "$CAN_SUDO" -eq 1 ]] && extents="$(as_root filefrag "$image" 2>/dev/null | awk '{print $(NF-2)}' || true)"
            size_mb=$((($(stat -c %s "$image" 2>/dev/null || echo 0)) / 1024 / 1024))
            if [[ "$extents" =~ ^[0-9]+$ ]]; then
                echo "[INFO] Disk image: $(basename "$image") -> ${size_mb}MB (${extents} extents)"
                if [[ "$extents" -gt 5000 ]]; then
                    if [[ -w "$image" ]]; then
                        btrfs filesystem defragment -f "$image" 2>/dev/null || true
                    elif [[ "$CAN_SUDO" -eq 1 ]]; then
                        as_root btrfs filesystem defragment -f "$image" 2>/dev/null || true
                    fi
                fi
            fi
        done < <(find "$vm_dir" -maxdepth 2 -type f \( -name "*.qcow2" -o -name "*.raw" -o -name "*.img" \) -print0 2>/dev/null)
    done
    [[ "$vm_found" -eq 0 ]] && echo "[OK] No VM disk images found."
}

phase_safe_hygiene() {
    echo "=== [4/5] Safe Cache, Flatpak & Image Hygiene ==="
    if command -v flatpak >/dev/null 2>&1; then
        [[ "$USER_SCOPE" -eq 1 ]] && as_user flatpak uninstall --unused -y >/dev/null 2>&1 || true
        [[ "$CAN_SUDO" -eq 1 ]] && as_root flatpak uninstall --unused -y >/dev/null 2>&1 || true
        echo "[OK] Unused Flatpak runtimes pruned."
    fi

    if command -v podman >/dev/null 2>&1; then
        [[ "$USER_SCOPE" -eq 1 ]] && as_user podman image prune -f >/dev/null 2>&1 || true
        [[ "$CAN_SUDO" -eq 1 ]] && as_root podman image prune -f >/dev/null 2>&1 || true
        echo "[OK] Dangling Podman images pruned (containers and volumes preserved)."
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        [[ -d "${REAL_HOME}/.cache/thumbnails" ]] &&
            find "${REAL_HOME}/.cache/thumbnails" -type f -atime +30 -delete 2>/dev/null || true
        if [[ -d "${REAL_HOME}/.cache/huggingface/hub" ]]; then
            find "${REAL_HOME}/.cache/huggingface/hub" -name "*.incomplete" -delete 2>/dev/null || true
            find "${REAL_HOME}/.cache/huggingface/hub" -name "*.lock" -atime +30 -delete 2>/dev/null || true
        fi
        echo "[OK] Thumbnail and Hugging Face cache hygiene completed."
    fi
}

audit_warn() {
    echo "[WARN] $*"
    AUDIT_WARNINGS=$((AUDIT_WARNINGS + 1))
}

audit_pillars() {
    AUDIT_WARNINGS=0

    echo "--- [Pillar 1/5] Supply Chain, Keys & Signing ---"
    if command -v mokutil >/dev/null 2>&1; then
        local sb_state enrolled
        sb_state="$(mokutil --sb-state 2>/dev/null || true)"
        if grep -qi "enabled" <<<"$sb_state"; then
            enrolled="$(mokutil --list-enrolled 2>/dev/null || true)"
            if grep -qi "ublue" <<<"$enrolled"; then
                echo "[OK] Secure Boot enabled with the enrolled ublue MOK certificate."
            else
                echo "[OK] Secure Boot enabled (standard key set)."
            fi
        else
            echo "[INFO] Secure Boot disabled in firmware."
        fi
    fi
    [[ -f /etc/pki/akmods/certs/akmods-ublue.der ]] && echo "[OK] Versioned MOK certificate present in /etc/pki/akmods/certs/."
    [[ -f /usr/lib/modprobe.d/60-security-blacklist.conf ]] && echo "[OK] CIS modprobe security blacklist active."
    if [[ -f /etc/containers/policy.json ]] && grep -q "sigstoreSigned" /etc/containers/policy.json; then
        echo "[OK] Cosign sigstore policy configured in /etc/containers/policy.json."
    fi

    echo "--- [Pillar 2/5] ZRAM, VM & Btrfs Storage ---"
    if command -v zramctl >/dev/null 2>&1; then
        local zram_info
        zram_info="$(zramctl --output NAME,ALGORITHM,DISKSIZE,DATA --noheadings 2>/dev/null | head -n 1 || true)"
        [[ -n "$zram_info" ]] && echo "[OK] ZRAM active: $zram_info"
    fi

    local swappiness page_cluster dirty_bg dirty_bytes
    swappiness="$(cat /proc/sys/vm/swappiness 2>/dev/null || echo N/A)"
    page_cluster="$(cat /proc/sys/vm/page-cluster 2>/dev/null || echo N/A)"
    if [[ "$swappiness" == "150" && "$page_cluster" == "0" ]]; then
        echo "[OK] ZRAM VM parameters: vm.swappiness=${swappiness}, vm.page-cluster=${page_cluster}."
    else
        audit_warn "ZRAM VM drift: vm.swappiness=${swappiness} (target 150), vm.page-cluster=${page_cluster} (target 0)."
    fi

    dirty_bg="$(cat /proc/sys/vm/dirty_background_bytes 2>/dev/null || echo N/A)"
    dirty_bytes="$(cat /proc/sys/vm/dirty_bytes 2>/dev/null || echo N/A)"
    if [[ "$dirty_bg" == "67108864" && "$dirty_bytes" == "268435456" ]]; then
        echo "[OK] NVMe writeback caps: dirty_background_bytes=${dirty_bg}, dirty_bytes=${dirty_bytes}."
    elif [[ "$NEW_CONTRACT" -eq 1 ]]; then
        audit_warn "NVMe writeback drift: dirty_background_bytes=${dirty_bg}, dirty_bytes=${dirty_bytes}."
    else
        echo "[INFO] NVMe writeback byte caps pending deployment/reboot into new image."
    fi

    local -a nocow_paths=("${NOCOW_SYSTEM_DIRS[@]}") user_nocow=()
    mapfile -t user_nocow < <(get_nocow_user_dirs)
    nocow_paths+=("${user_nocow[@]}")
    local path attrs
    for path in "${nocow_paths[@]}"; do
        [[ -d "$path" ]] || continue
        command -v lsattr >/dev/null 2>&1 || continue
        attrs=$([[ "$CAN_SUDO" -eq 1 ]] && as_root lsattr -d "$path" 2>/dev/null | awk '{print $1}' || lsattr -d "$path" 2>/dev/null | awk '{print $1}' || true)
        if grep -q "C" <<<"$attrs"; then
            echo "[OK] NoCOW (+C) verified on: $path"
        elif [[ -n "$attrs" ]]; then
            audit_warn "Directory without NoCOW (+C): $path"
        else
            echo "[SKIP] Insufficient permissions to inspect NoCOW (+C) on: $path"
        fi
    done

    local nvme_ra_file ra_val
    for nvme_ra_file in /sys/block/nvme*n*/queue/read_ahead_kb; do
        [[ -r "$nvme_ra_file" ]] || continue
        ra_val="$(cat "$nvme_ra_file" 2>/dev/null || true)"
        if [[ "$ra_val" == "256" ]]; then
            echo "[OK] NVMe read_ahead_kb=256 (${nvme_ra_file%/queue/read_ahead_kb})."
        elif [[ -n "$ra_val" ]]; then
            audit_warn "NVMe read_ahead_kb drift on ${nvme_ra_file}: ${ra_val} (target 256)."
        fi
    done

    echo "--- [Pillar 3/5] GPU Acceleration & Headless Isolation ---"
    if command -v vulkaninfo >/dev/null 2>&1; then
        local vk_out vk_device
        vk_out="$(vulkaninfo --summary 2>/dev/null || true)"
        vk_device="$(awk -F'=' '/deviceName/ {print $2; exit}' <<<"$vk_out" | xargs || true)"
        [[ -n "$vk_device" ]] && echo "[OK] Primary Vulkan device: $vk_device"
    fi
    if [[ -n "${AMD_RENDER_PATH:-}" && -e "$AMD_RENDER_PATH" ]]; then
        echo "[OK] AMD DRM render node present (${AMD_RENDER_PATH})."
    else
        audit_warn "AMD DRM render node not detected via amdgpu driver."
    fi
    [[ -e /dev/dri/primary-render ]] && echo "[OK] /dev/dri/primary-render -> $(readlink /dev/dri/primary-render)"
    if [[ -f /etc/cdi/nvidia.yaml || -f /run/cdi/nvidia.yaml || -f /var/run/cdi/nvidia.yaml ]]; then
        echo "[OK] NVIDIA Container Device Interface (CDI) active."
    fi
    if command -v nvidia-smi >/dev/null 2>&1; then
        local nv_gpu
        nv_gpu="$(nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader,nounits 2>/dev/null | head -n 1 || true)"
        [[ -n "$nv_gpu" ]] && echo "[OK] NVIDIA GPU: $nv_gpu (headless compute/AI)."
    fi
    if [[ -n "${NVIDIA_RENDER_PATH:-}" && -e "$NVIDIA_RENDER_PATH" ]]; then
        if is_nvidia_headless_image; then
            audit_warn "NVIDIA DRM render node detected (${NVIDIA_RENDER_PATH}) on headless image."
        else
            echo "[INFO] NVIDIA DRM render node detected (${NVIDIA_RENDER_PATH}) on kinoite-amd."
        fi
    else
        echo "[OK] Clean graphics isolation: AMD GPU exclusively owns DRM render nodes."
    fi

    echo "--- [Pillar 4/5] Kernel, Boot & Hardware Resilience ---"
    local sysrq
    sysrq="$(cat /proc/sys/kernel/sysrq 2>/dev/null || echo N/A)"
    [[ "$sysrq" == "1" ]] && echo "[OK] Kernel SysRq: 1 (safe REISUB enabled)." || audit_warn "Kernel SysRq mismatch: ${sysrq} (expected 1)."

    local cmdline banned detected=0
    local -a banned_list=()
    cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
    mapfile -t banned_list < <(get_unwanted_kargs)
    for banned in "${banned_list[@]}"; do
        if grep -qwF "$banned" <<<"$cmdline"; then
            if [[ "$banned" == "initcall_blacklist=simpledrm_platform_driver_init" && "$NEW_CONTRACT" -eq 0 ]]; then
                echo "[INFO] Legacy karg pending deployment/reboot into new image: $banned"
            else
                audit_warn "Redundant/unsafe karg detected on boot line: $banned"
                detected=1
            fi
        fi
    done
    [[ "$detected" -eq 0 ]] && echo "[OK] Clean boot line (no active unsafe/redundant kargs)."

    local cpufreq_drv=""
    for cpufreq_drv in /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver /sys/devices/system/cpu/cpufreq/policy0/scaling_driver; do
        [[ -r "$cpufreq_drv" ]] && break
        cpufreq_drv=""
    done
    if [[ -n "$cpufreq_drv" ]]; then
        echo "[OK] CPU frequency scaling driver: $(cat "$cpufreq_drv" 2>/dev/null)"
    else
        echo "[INFO] CPU frequency scaling inactive (check CPPC / Cool'n'Quiet PSS in BIOS)."
    fi

    local root_state
    if command -v passwd >/dev/null 2>&1 && root_state="$(passwd -S root 2>/dev/null | awk '{print $2}')" && [[ -n "$root_state" ]]; then
        case "$root_state" in
            P) echo "[OK] Root password set: sulogin protects emergency/rescue consoles." ;;
            NP) audit_warn "Root account has no password: emergency shell would be unauthenticated." ;;
            L) audit_warn "Root account is locked: sulogin cannot authenticate recovery sessions." ;;
            *) echo "[INFO] Root account state '${root_state}'." ;;
        esac
    else
        echo "[SKIP] Root account state unavailable (run as root to verify sulogin)."
    fi

    echo "--- [Pillar 5/5] Updates, Maintenance & Host Hygiene ---"
    local required_timers=(
        "bootc-fetch-apply-updates.timer"
        "flatpak-system-update.timer"
        "podman-auto-update.timer"
        "kinoite-maintenance.timer"
        "kinoite-btrfs-scrub.timer"
    )
    local timer_states idx=0 state inactive_timers=()
    if timer_states="$(systemctl is-active "${required_timers[@]}" 2>/dev/null)" || [[ -n "$timer_states" ]]; then
        while IFS= read -r state; do
            [[ "$state" != "active" ]] && inactive_timers+=("${required_timers[$idx]}(${state:-unknown})")
            idx=$((idx + 1))
        done <<<"$timer_states"
        if [[ ${#inactive_timers[@]} -gt 0 ]]; then
            audit_warn "Inactive system timer(s): ${inactive_timers[*]}"
        else
            echo "[OK] System update and maintenance timers: all ${#required_timers[@]} active."
        fi
    else
        echo "[SKIP] System timer state unavailable."
    fi

    if [[ "$USER_SCOPE" -eq 1 ]]; then
        local user_uid runtime_dir
        user_uid="$(id -u "$REAL_USER" 2>/dev/null || true)"
        runtime_dir="/run/user/${user_uid}"
        if [[ -n "$user_uid" && -S "${runtime_dir}/systemd/private" ]]; then
            local user_timers=("flatpak-user-update.timer" "kinoite-user-maintenance.timer" "podman-auto-update.timer")
            local u_states u_idx=0 u_state inactive_user=()
            u_states="$(as_user env XDG_RUNTIME_DIR="$runtime_dir" systemctl --user is-active "${user_timers[@]}" 2>/dev/null || true)"
            if [[ -n "$u_states" ]]; then
                while IFS= read -r u_state; do
                    [[ "$u_state" != "active" ]] && inactive_user+=("${user_timers[$u_idx]}(${u_state:-unknown})")
                    u_idx=$((u_idx + 1))
                done <<<"$u_states"
                if [[ ${#inactive_user[@]} -gt 0 ]]; then
                    audit_warn "Inactive user timer(s): ${inactive_user[*]}"
                else
                    echo "[OK] User update and maintenance timers: all ${#user_timers[@]} active."
                fi
            fi
        fi
    fi

    [[ -f /etc/xdg/baloofilerc ]] && grep -qE "rclone|/run/user" /etc/xdg/baloofilerc && echo "[OK] KDE Baloo cloud exclusion: active."
    [[ -d /var/home ]] && echo "[STATUS] Free space on /var/home: $(df -h /var/home | awk 'NR==2 {print $4}')"

    local residue found_residues=()
    for residue in "${LEGACY_HOST_RESIDUES[@]}"; do
        [[ -e "$residue" || -L "$residue" ]] && found_residues+=("$residue")
    done
    if [[ ${#found_residues[@]} -gt 0 ]]; then
        echo "[INFO] Legacy host residues present (${#found_residues[@]}; cleaned by 'sudo kinoite-optimize' after image deploy): ${found_residues[*]}"
    else
        echo "[OK] Host mutable state clean (zero legacy residues)."
    fi
}

main() {
    detect_privileges
    detect_target_user

    if [[ "$MODE" == "apply" ]]; then
        phase_sysctl_and_tmpfiles
        phase_nocow_and_cloud
        phase_btrfs_and_vms
        phase_safe_hygiene
        echo "=== [5/5] System Health & Integrity Audit ==="
        audit_pillars
        echo "=== Maintenance Completed (warnings: ${AUDIT_WARNINGS}) ==="
        return 0
    fi

    echo "============================================================="
    echo "=== [AUDIT] Five Engineering Pillars (Read-Only)"
    echo "============================================================="
    audit_pillars
    echo "============================================================="
    if [[ "$AUDIT_WARNINGS" -gt 0 ]]; then
        echo "=== Audit Failed: ${AUDIT_WARNINGS} warning(s) detected"
        echo "============================================================="
        return 1
    fi
    echo "=== Audit Completed Successfully"
    echo "============================================================="
}

main "$@"

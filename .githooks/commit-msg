#!/bin/sh
# Conventional Commits guard for this repository.
# Enable with: make hooks   (git config core.hooksPath .githooks)

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Allow merge/revert/fixup/squash commits produced by git itself.
case "$subject" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "*)
        exit 0
        ;;
esac

if [ -z "$(printf '%s' "$subject" | tr -d '[:space:]')" ]; then
    echo "ERROR: empty commit message." >&2
    echo "Use Conventional Commits, e.g. 'fix(ci): describe the change'." >&2
    exit 1
fi

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .{1,72}$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    echo "ERROR: invalid commit subject: $subject" >&2
    echo "Expected: <type>(<scope>): <description>" >&2
    echo "Types: build chore ci docs feat fix perf refactor revert style test" >&2
    exit 1
fi

exit 0
